<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_sst_medico" model="res.groups">
        <field name="name">Saúde Ocupacional</field>
        <field name="category_id" ref="l10n_br_hr_sst.module_category_l10n_br_hr_sst" />
        <field name="implied_ids" eval="[(4, ref('l10n_br_hr_sst.group_sst_user'))]" />
        <field name="comment">Acessa dado clínico do trabalhador (LGPD art. 11). Grupo
            distinto do RH: quem cuida da folha não precisa, e não deve, enxergar
            prontuário.</field>
    </record>

    <!-- Sigilo: o RH vê o ASO do trabalhador, o trabalhador vê o próprio, e a
         saúde ocupacional vê tudo. A regra do hr_employee_medical_examination
         já restringe o usuário comum aos próprios exames; aqui ela ganha o
         recorte por empresa e o acesso da saúde ocupacional. -->
    <record id="hr_medical_examination_rule_medico" model="ir.rule">
        <field name="name">Saúde Ocupacional: exames da empresa</field>
        <field
            name="model_id"
            ref="hr_employee_medical_examination.model_hr_employee_medical_examination"
        />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_sst_medico')])]" />
    </record>

    <!-- Exame complementar tem dado clínico (procedimento e indicativo do
         resultado). Sem regra, a permissão de leitura do usuário comum deixava
         qualquer funcionário ler os exames de todos os colegas. Espelha as
         regras do exame: o usuário comum vê só os próprios, o gestor de RH vê
         todos e a saúde ocupacional vê os da empresa. -->
    <record id="l10n_br_sst_exame_complementar_rule_base" model="ir.rule">
        <field name="name">Exame complementar: somente os próprios</field>
        <field name="model_id" ref="model_l10n_br_sst_exame_complementar" />
        <field
            name="domain_force"
        >[('examination_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>

    <record id="l10n_br_sst_exame_complementar_rule_hr" model="ir.rule">
        <field name="name">Exame complementar: gestor de RH</field>
        <field name="model_id" ref="model_l10n_br_sst_exame_complementar" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('hr.group_hr_manager')])]" />
    </record>

    <record id="l10n_br_sst_exame_complementar_rule_medico" model="ir.rule">
        <field name="name">Exame complementar: saúde ocupacional</field>
        <field name="model_id" ref="model_l10n_br_sst_exame_complementar" />
        <field
            name="domain_force"
        >['|', ('examination_id.company_id', '=', False), ('examination_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_sst_medico')])]" />
    </record>

    <record id="l10n_br_sst_pcmso_company_rule" model="ir.rule">
        <field name="name">PCMSO: multiempresa</field>
        <field name="model_id" ref="model_l10n_br_sst_pcmso" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
