<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_company_view_form_sst_aso" model="ir.ui.view">
        <field name="name">res.company.form (in l10n_br_hr_sst_aso)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Saúde e Segurança do Trabalho" name="l10n_br_sst">
                    <field name="l10n_br_sst_aso_politica" />
                    <field name="l10n_br_sst_aso_alerta_dias" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
