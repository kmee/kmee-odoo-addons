<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_medical_examination_form_view_sst" model="ir.ui.view">
        <field
            name="name"
        >hr.employee.medical.examination.form (in l10n_br_hr_sst_aso)</field>
        <field name="model">hr.employee.medical.examination</field>
        <field
            name="inherit_id"
            ref="hr_employee_medical_examination.hr_employee_medical_examination_form_view"
        />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="l10n_br_tipo_aso_id" />
                <field name="l10n_br_date_vencimento" />
                <field name="l10n_br_pcmso_id" />
            </field>
            <field name="result" position="before">
                <field name="l10n_br_resultado" />
                <field name="l10n_br_com_restricao" />
                <field
                    name="l10n_br_restricao"
                    attrs="{'invisible': [('l10n_br_com_restricao', '=', False)]}"
                />
            </field>
            <field name="result" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//sheet" position="inside">
                <group string="Emitente do ASO" name="l10n_br_emitente">
                    <group>
                        <field name="l10n_br_medico_nome" />
                        <field name="l10n_br_crm" />
                        <field name="l10n_br_uf_crm" />
                    </group>
                    <group>
                        <field name="l10n_br_clinica_id" />
                    </group>
                </group>
                <notebook>
                    <page string="Exames Complementares" name="exames">
                        <field name="l10n_br_exame_ids">
                            <tree editable="bottom">
                                <field name="procedimento_id" />
                                <field name="date" />
                                <field name="ord_exame" />
                                <field name="ind_result" />
                                <field name="observacao" />
                            </tree>
                        </field>
                    </page>
                    <page
                        string="Sigilo Médico"
                        name="sigilo"
                        groups="l10n_br_hr_sst_aso.group_sst_medico"
                    >
                        <field name="l10n_br_observacao_clinica" nolabel="1" />
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record
        id="hr_employee_medical_examination_action_vencimentos"
        model="ir.actions.act_window"
    >
        <field name="name">Vencimentos de ASO</field>
        <field name="res_model">hr.employee.medical.examination</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{'search_default_group_tipo': 1}</field>
    </record>

    <record id="hr_employee_medical_examination_search_view_sst" model="ir.ui.view">
        <field
            name="name"
        >hr.employee.medical.examination.search (in l10n_br_hr_sst_aso)</field>
        <field name="model">hr.employee.medical.examination</field>
        <field
            name="inherit_id"
            ref="hr_employee_medical_examination.hr_employee_medical_examination_search_view"
        />
        <field name="arch" type="xml">
            <search position="inside">
                <filter
                    name="filter_vencido"
                    string="ASO Vencido"
                    domain="[('l10n_br_date_vencimento', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_tipo"
                        string="Tipo de ASO"
                        context="{'group_by': 'l10n_br_tipo_aso_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

</odoo>
