<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_salary_history_view_list" model="ir.ui.view">
        <field name="name">hr.employee.salary.history.list</field>
        <field name="model">hr.employee.salary.history</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="employee_id" />
                <field name="date" />
                <field name="reason" />
                <field name="currency_id" column_invisible="1" />
                <field name="previous_salary" />
                <field name="salary" />
                <field name="increase_percentage" string="Increase (%)" />
            </list>
        </field>
    </record>
    <record id="hr_employee_salary_history_view_search" model="ir.ui.view">
        <field name="name">hr.employee.salary.history.search</field>
        <field name="model">hr.employee.salary.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="reason" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_employee"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="group_date"
                        string="Date"
                        context="{'group_by': 'date:year'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="hr_employee_salary_history_action" model="ir.actions.act_window">
        <field name="name">Salary History</field>
        <field name="res_model">hr.employee.salary.history</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="hr_employee_salary_history_menu"
        name="Salary History"
        parent="hr.menu_hr_employee_payroll"
        action="hr_employee_salary_history_action"
        groups="hr.group_hr_user"
        sequence="30"
    />
</odoo>
