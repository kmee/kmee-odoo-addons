<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template
        id="purchase_report_hide_date"
        name="purchase_hide_date"
        inherit_id="purchase.report_purchaseorder_document"
        priority="100"
    >
        <xpath expr="//div[@id='informations']/div[contains(@t-if,'date_approve')]" position="replace">
        </xpath>

        <xpath expr="//div[@id='informations']/div[contains(@t-elif,'date_order')]" position="replace">
        </xpath>

        <xpath expr="//div[@id='informations']/div[contains(@t-if,'date_planned')]" position="replace">
        </xpath>

    </template>
</odoo>
