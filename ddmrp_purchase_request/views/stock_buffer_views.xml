<odoo>
    <record id="stock_buffer_view_form" model="ir.ui.view">
        <field name="name">stock.buffer.form - ddmrp_purchase_request</field>
        <field name="model">stock.buffer</field>
        <field name="inherit_id" ref="ddmrp.stock_buffer_view_form" />
        <field name="arch" type="xml">
            <button name="action_view_purchase" position="after">
                <button
                    type="object"
                    name="action_view_purchase_request"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    invisible="item_type != 'purchased'"
                >
                    <div class="o_stat_info">
                        <field
                            name="purchase_request_pending_qty"
                            class="o_stat_value"
                        />
                        <span class="o_stat_text">Requested</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
