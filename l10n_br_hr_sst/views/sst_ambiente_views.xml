<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_sst_ambiente_view_tree" model="ir.ui.view">
        <field name="name">l10n_br.sst.ambiente.tree</field>
        <field name="model">l10n_br.sst.ambiente</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="dsc_setor" />
                <field name="local_amb" />
                <field name="nr_insc" />
                <field name="risco_count" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_sst_ambiente_view_form" model="ir.ui.view">
        <field name="name">l10n_br.sst.ambiente.form</field>
        <field name="model">l10n_br.sst.ambiente</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_riscos"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                        >
                            <field
                                name="risco_count"
                                widget="statinfo"
                                string="Riscos"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Setor de produção" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="dsc_setor" />
                            <field name="local_amb" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="tp_insc" />
                            <field name="nr_insc" />
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Atividades">
                        <field name="descricao_atividade" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="Fatores de Risco" name="riscos">
                            <field name="risco_ids">
                                <tree>
                                    <field name="agente_nocivo_id" />
                                    <field name="tp_aval" />
                                    <field name="intensidade" />
                                    <field name="date_from" />
                                    <field name="date_to" />
                                    <field name="laudo_id" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_sst_ambiente_view_search" model="ir.ui.view">
        <field name="name">l10n_br.sst.ambiente.search</field>
        <field name="model">l10n_br.sst.ambiente</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="dsc_setor" />
                <field name="nr_insc" />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_local"
                        string="Local do Ambiente"
                        context="{'group_by': 'local_amb'}"
                    />
                    <filter
                        name="group_insc"
                        string="Estabelecimento"
                        context="{'group_by': 'nr_insc'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_br_sst_ambiente_action" model="ir.actions.act_window">
        <field name="name">Ambientes de Trabalho</field>
        <field name="res_model">l10n_br.sst.ambiente</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
