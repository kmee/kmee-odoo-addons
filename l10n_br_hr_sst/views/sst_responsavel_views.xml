<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_sst_responsavel_view_tree" model="ir.ui.view">
        <field name="name">l10n_br.sst.responsavel.tree</field>
        <field name="model">l10n_br.sst.responsavel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="cpf" />
                <field name="ide_oc" />
                <field name="nr_oc" />
                <field name="uf_oc" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_sst_responsavel_view_form" model="ir.ui.view">
        <field name="name">l10n_br.sst.responsavel.form</field>
        <field name="model">l10n_br.sst.responsavel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cpf" />
                            <field name="partner_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="ide_oc" />
                            <field
                                name="dsc_oc"
                                attrs="{'invisible': [('ide_oc', '!=', '9')], 'required': [('ide_oc', '=', '9')]}"
                            />
                            <field name="nr_oc" />
                            <field name="uf_oc" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_sst_responsavel_action" model="ir.actions.act_window">
        <field name="name">Responsáveis Técnicos</field>
        <field name="res_model">l10n_br.sst.responsavel</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
