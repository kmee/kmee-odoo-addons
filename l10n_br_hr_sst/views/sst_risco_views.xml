<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_br_sst_risco_view_tree" model="ir.ui.view">
        <field name="name">l10n_br.sst.risco.list</field>
        <field name="model">l10n_br.sst.risco</field>
        <field name="arch" type="xml">
            <list decoration-muted="ausencia_de_risco">
                <field name="ambiente_id" />
                <field name="agente_nocivo_id" />
                <field name="tp_aval" optional="show" />
                <field name="intensidade" optional="show" />
                <field name="un_med" optional="hide" />
                <field name="insalubridade" optional="show" />
                <field name="grau_insalubridade" optional="show" />
                <field name="periculosidade" optional="show" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="laudo_id" optional="show" />
                <field name="ausencia_de_risco" invisible="1" />
            </list>
        </field>
    </record>

    <record id="l10n_br_sst_risco_view_form" model="ir.ui.view">
        <field name="name">l10n_br.sst.risco.form</field>
        <field name="model">l10n_br.sst.risco</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Identifica&#231;&#227;o">
                            <field name="ambiente_id" />
                            <field name="agente_nocivo_id" />
                            <field name="ausencia_de_risco" />
                            <field name="laudo_id" />
                            <field name="job_ids" widget="many2many_tags" />
                        </group>
                        <group string="Vig&#234;ncia">
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not aviso_adicionais"
                    >
                        <field name="aviso_adicionais" readonly="1" />
                    </div>
                    <notebook>
                        <page string="Avalia&#231;&#227;o" name="avaliacao">
                            <group>
                                <group>
                                    <field name="tp_aval" />
                                    <field name="intensidade" />
                                    <field name="limite_tolerancia" />
                                </group>
                                <group>
                                    <field name="un_med" />
                                    <field name="tecnica_medicao" />
                                    <field name="nr_proc_jud" />
                                </group>
                            </group>
                            <group string="Descri&#231;&#227;o Complementar">
                                <field name="descricao" nolabel="1" />
                            </group>
                        </page>
                        <page string="Prote&#231;&#227;o (EPC/EPI)" name="protecao">
                            <group>
                                <group>
                                    <field name="utiliz_epc" />
                                    <field
                                        name="efic_epc"
                                        invisible="utiliz_epc != '2'"
                                    />
                                </group>
                                <group>
                                    <field name="utiliz_epi" />
                                    <field
                                        name="efic_epi"
                                        invisible="utiliz_epi != '2'"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="Consequ&#234;ncias" name="consequencias">
                            <group>
                                <group string="Previdenci&#225;rio">
                                    <field name="aposentadoria_especial_id" />
                                    <field name="financiamento_aposent_id" />
                                </group>
                                <group string="Trabalhista">
                                    <field name="insalubridade" />
                                    <field
                                        name="grau_insalubridade"
                                        invisible="not insalubridade"
                                        required="insalubridade"
                                    />
                                    <field name="periculosidade" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="l10n_br_sst_risco_view_search" model="ir.ui.view">
        <field name="name">l10n_br.sst.risco.search</field>
        <field name="model">l10n_br.sst.risco</field>
        <field name="arch" type="xml">
            <search>
                <field name="ambiente_id" />
                <field name="agente_nocivo_id" />
                <field name="laudo_id" />
                <filter
                    name="filter_vigente"
                    string="Vigentes"
                    domain="['&amp;', ('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')), '|', ('date_to', '=', False), ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="filter_insalubridade"
                    string="Geram Insalubridade"
                    domain="[('insalubridade', '=', True)]"
                />
                <filter
                    name="filter_periculosidade"
                    string="Geram Periculosidade"
                    domain="[('periculosidade', '=', True)]"
                />
                <filter
                    name="filter_especial"
                    string="Aposentadoria Especial"
                    domain="[('financiamento_aposent_id.codigo', 'in', ['2', '3', '4'])]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_ambiente"
                        string="Ambiente"
                        context="{'group_by': 'ambiente_id'}"
                    />
                    <filter
                        name="group_agente"
                        string="Agente Nocivo"
                        context="{'group_by': 'agente_nocivo_id'}"
                    />
                    <filter
                        name="group_laudo"
                        string="Laudo"
                        context="{'group_by': 'laudo_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_br_sst_risco_action" model="ir.actions.act_window">
        <field name="name">Fatores de Risco</field>
        <field name="res_model">l10n_br.sst.risco</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_vigente': 1}</field>
    </record>
</odoo>
