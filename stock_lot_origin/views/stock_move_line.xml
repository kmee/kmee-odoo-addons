<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">stock.move.line.list (in stock_lot_origin)</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field
                    name="lot_origin_picking_id"
                    optional="hide"
                    groups="stock.group_production_lot"
                />
                <field
                    name="lot_origin_purchase_id"
                    optional="hide"
                    groups="stock.group_production_lot"
                />
                <field
                    name="lot_origin_sale_id"
                    optional="hide"
                    groups="stock.group_production_lot"
                />
            </field>
        </field>
    </record>

    <record id="view_move_line_form" model="ir.ui.view">
        <field name="name">stock.move.line.form (in stock_lot_origin)</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field
                    name="lot_origin_picking_id"
                    invisible="not lot_origin_picking_id"
                />
                <field
                    name="lot_origin_purchase_id"
                    invisible="not lot_origin_purchase_id"
                />
                <field name="lot_origin_sale_id" invisible="not lot_origin_sale_id" />
            </field>
        </field>
    </record>
</odoo>
