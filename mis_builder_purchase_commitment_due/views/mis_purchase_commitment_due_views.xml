<odoo>
    <record id="mis_purchase_commitment_due_view_list" model="ir.ui.view">
        <field name="name">mis.purchase.commitment.due.list</field>
        <field name="model">mis.purchase.commitment.due</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_sync_all"
                        type="object"
                        string="Resync"
                        display="always"
                        groups="account.group_account_manager"
                    />
                </header>
                <field name="date" />
                <field name="purchase_order_id" />
                <field name="name" optional="hide" />
                <field name="partner_id" />
                <field name="payment_term_id" optional="show" />
                <field name="account_id" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="currency_id" column_invisible="1" />
                <field name="amount" sum="Total" />
            </list>
        </field>
    </record>

    <record id="mis_purchase_commitment_due_view_pivot" model="ir.ui.view">
        <field name="name">mis.purchase.commitment.due.pivot</field>
        <field name="model">mis.purchase.commitment.due</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Commitments by Due Date">
                <field name="date" interval="month" type="col" />
                <field name="partner_id" type="row" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="mis_purchase_commitment_due_view_graph" model="ir.ui.view">
        <field name="name">mis.purchase.commitment.due.graph</field>
        <field name="model">mis.purchase.commitment.due</field>
        <field name="arch" type="xml">
            <graph string="Purchase Commitments by Due Date" type="bar">
                <field name="date" interval="week" />
                <field name="amount" type="measure" />
            </graph>
        </field>
    </record>

    <record id="mis_purchase_commitment_due_view_search" model="ir.ui.view">
        <field name="name">mis.purchase.commitment.due.search</field>
        <field name="model">mis.purchase.commitment.due</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="purchase_order_id" />
                <filter
                    name="future"
                    string="Due from today"
                    domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="overdue"
                    string="Overdue"
                    domain="[('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_partner"
                        string="Vendor"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_month"
                        string="Due Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="mis_purchase_commitment_due_action" model="ir.actions.act_window">
        <field name="name">Purchase Commitments to Pay</field>
        <field name="res_model">mis.purchase.commitment.due</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_future': 1}</field>
    </record>

    <menuitem
        id="menu_mis_purchase_commitment_due"
        action="mis_purchase_commitment_due_action"
        parent="purchase.purchase_report_main"
        sequence="30"
    />
</odoo>
