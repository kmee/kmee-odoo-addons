<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_accounting_technical" model="ir.module.category">
        <field name="name">Technical</field>
        <field name="parent_id" ref="base.module_category_accounting_accounting" />
    </record>
    <record id="group_edit_posted_maturity" model="res.groups">
        <field name="name">Edit due date of posted journal items</field>
        <field name="category_id" ref="module_category_accounting_technical" />
        <field name="comment">Allows changing the due date of payable/receivable lines of posted entries.</field>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_edit_posted_maturity'))]" />
    </record>
</odoo>
