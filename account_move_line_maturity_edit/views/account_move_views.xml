<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Journal Entries: view_no_maturity is removed from the action context
         by a function call (see ir_actions_act_window.py), so the other keys
         are preserved and the change is re-applied on every module update. -->
    <function
        model="ir.actions.act_window"
        name="_maturity_edit_fix_action_context"
    />

    <!-- Journal Items: Due Date editable on open payable/receivable lines.
         Posted lines additionally require the dedicated group. -->
    <record id="view_move_line_tree_maturity_edit" model="ir.ui.view">
        <field name="name">account.move.line.list.maturity.edit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_maturity']" position="attributes">
                <attribute
                    name="readonly"
                >account_type not in ('asset_receivable', 'liability_payable') or reconciled or display_type in ('line_section', 'line_note') or (parent_state == 'posted' and not can_edit_posted_maturity)</attribute>
            </xpath>
            <xpath expr="//field[@name='date_maturity']" position="after">
                <field name="account_type" column_invisible="1" />
                <field name="reconciled" column_invisible="1" />
                <field name="display_type" column_invisible="1" />
                <field name="parent_state" column_invisible="1" />
                <field name="can_edit_posted_maturity" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
