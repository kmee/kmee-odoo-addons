<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Journal Entries: show the optional Due Date column on entry lines -->
    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field
            name="context"
        >{'default_move_type': 'entry', 'search_default_posted': 1}</field>
    </record>

    <!-- Journal Items: Due Date editable on open payable/receivable lines.
         Posted lines additionally require the dedicated group (see next view). -->
    <record id="view_move_line_tree_maturity_edit" model="ir.ui.view">
        <field name="name">account.move.line.list.maturity.edit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_maturity']" position="attributes">
                <attribute
                    name="readonly"
                >account_type not in ('asset_receivable', 'liability_payable') or reconciled or display_type in ('line_section', 'line_note') or parent_state == 'posted'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_maturity']" position="after">
                <field name="account_type" column_invisible="1" />
                <field name="reconciled" column_invisible="1" />
                <field name="display_type" column_invisible="1" />
                <field name="parent_state" column_invisible="1" />
            </xpath>
        </field>
    </record>
    <record id="view_move_line_tree_maturity_edit_posted" model="ir.ui.view">
        <field name="name">account.move.line.list.maturity.edit.posted</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='date_maturity']"
                position="attributes"
                groups="account_move_line_maturity_edit.group_edit_posted_maturity"
            >
                <attribute
                    name="readonly"
                >account_type not in ('asset_receivable', 'liability_payable') or reconciled or display_type in ('line_section', 'line_note')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
