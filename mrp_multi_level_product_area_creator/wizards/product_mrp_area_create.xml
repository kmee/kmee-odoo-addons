<odoo>

    <record model="ir.ui.view" id="product_mrp_area_create_form_view">
        <field name="model">product.mrp.area.create</field>
        <field name="arch" type="xml">
            <form string="Product Mrp Area Create">
                <!-- TODO -->
                <group>
                    <field name="mrp_area_id" />
                </group>
                <field name="product_ids" options="{'no_create': True}" />
                <footer>
                    <button name="doit" string="OK" class="btn-primary" type="object" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="product_mrp_area_create_act_window">
        <field name="name">Product Mrp Area Create</field> <!-- TODO -->
        <field name="res_model">product.mrp.area.create</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

