<odoo>

    <record model="ir.ui.view" id="l10n_br_public_holidays_wizard_form_view">
        <field name="model">l10n_br.public.holidays.wizard</field>
        <field name="arch" type="xml">
            <form>z
                <group>
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="interval_number" />
                    <field name="interval_type" />
                    <field name="state_id" />
                    <field name="city_id" />
                </group>
                <footer>
                    <button
                        name="import_brazilian_holidays"
                        string="Importar"
                        class="btn-primary"
                        type="object"
                    />

                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="l10n_br_public_holidays_wizard_act_window"
    >
        <field name="name">Importar Feriados do Brasil</field>
        <field name="res_model">l10n_br.public.holidays.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <record
        model="ir.ui.menu"
        id="hr_holidays_public.menu_create_next_year_public_holidays"
    >
        <field name="action" ref="l10n_br_public_holidays_wizard_act_window" />
    </record>

</odoo>
