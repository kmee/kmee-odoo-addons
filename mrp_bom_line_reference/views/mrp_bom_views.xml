<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.form.reference</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='bom_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field name="manufacturer_id" optional="show" />
                <field name="manufacturer_pname" optional="show" />
                <field name="manufacturer_pref" optional="show" />
                <field name="reference" optional="show" />
            </xpath>
        </field>
    </record>
    <record id="mrp_bom_line_view_form" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.reference</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="manufacturer_id" />
                <field name="manufacturer_pname" />
                <field name="manufacturer_pref" />
                <field name="reference" />
            </xpath>
        </field>
    </record>
</odoo>
