    <!-- Kanban view for tickets with current stage duration -->
    <record id="view_helpdesk_ticket_kanban_with_duration" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.with.duration</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_kanban" />
        <field name="arch" type="xml">
        <xpath expr="//kanban" position="inside">
            <field name="current_stage_total_duration" />
        </xpath>
        <xpath expr="//div[@class='o_kanban_record_top']" position="after">
                <div class="row mt-2 text-muted small">
                    <div class="col-6">
                        <div><i class="fa fa-clock-o" aria-hidden="true" /> <t
                                t-esc="record.current_stage_total_duration.raw_value"
                            /></div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
