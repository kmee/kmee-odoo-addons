<odoo>

    <record id="l10n_br_hr_apuracao_periodo_view_tree" model="ir.ui.view">
        <field name="model">l10n_br.hr.apuracao.periodo</field>
        <field name="arch" type="xml">
            <tree decoration-warning="inconsistencia_count > 0">
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="dia_count" />
                <field name="horas_extras" widget="float_time" />
                <field name="faltas" />
                <field name="inconsistencia_count" />
                <field name="state" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_hr_apuracao_periodo_view_form" model="ir.ui.view">
        <field name="model">l10n_br.hr.apuracao.periodo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_apurar"
                        type="object"
                        string="Apurar"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '=', 'fechado')]}"
                    />
                    <button
                        name="action_fechar"
                        type="object"
                        string="Fechar competência"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'apurado')]}"
                        confirm="Fechar a competência trava o recálculo dos dias. Confirma?"
                    />
                    <button
                        name="action_reabrir"
                        type="object"
                        string="Reabrir"
                        attrs="{'invisible': [('state', '!=', 'fechado')]}"
                        confirm="Reabrir permite recalcular dias que já alimentaram a folha. Confirma?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_ver_dias"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field name="dia_count" widget="statinfo" string="Dias" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Março/2026" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" />
                            <field name="date_to" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="horas_extras" widget="float_time" />
                            <field name="faltas" />
                            <field name="inconsistencia_count" />
                        </group>
                    </group>
                    <group string="Funcionários (vazio = todos)">
                        <field
                            name="employee_ids"
                            nolabel="1"
                            widget="many2many_tags"
                        />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="l10n_br_hr_apuracao_periodo_action" model="ir.actions.act_window">
        <field name="name">Competências de Apuração</field>
        <field name="res_model">l10n_br.hr.apuracao.periodo</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Abra a primeira competência</p>
            <p>
                A competência agrupa a apuração do mês. Apurar processa as marcações
                em jornada; fechar trava o recálculo e é o que dá à folha uma
                referência estável.
            </p>
        </field>
    </record>

</odoo>
