<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <th name="th_description" position="after">
            <th name="th_manufacturer" class="text-start">
                <strong>Manufacturer/PartNumber</strong>
            </th>
        </th>
        <td id="product" position="after">
            <td id="manufacturer" class="text-start">
                <span t-field="line.manufacturer" />
                <br t-if="line.manufacturer and line.manufacturer_pref" />
                <span t-field="line.manufacturer_pref" />
            </td>
        </td>
    </template>
</odoo>
