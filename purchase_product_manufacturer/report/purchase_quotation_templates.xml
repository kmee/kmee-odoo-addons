<odoo>
    <template
        id="report_purchasequotation_document"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <th name="th_description" position="after">
            <th name="th_manufacturer">
                <strong>Manufacturer/PartNumber</strong>
            </th>
        </th>
        <td id="product" position="after">
            <td id="manufacturer">
                <span t-field="order_line.manufacturer" />
                <br t-if="order_line.manufacturer and order_line.manufacturer_pref" />
                <span t-field="order_line.manufacturer_pref" />
            </td>
        </td>
    </template>
</odoo>
