<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Regras salariais de Férias.

        Convenção: mesmos padrões de l10n_br_hr_payroll.
        Variáveis bare code, NÃO usar rules.CÓDIGO.

        Fundamentação:
          - Férias gozadas + 1/3 constitucional: verbas TRIBUTÁVEIS
            (INSS, IRRF e FGTS incidem).
          - Abono pecuniário (venda de até 1/3 das férias, CLT art. 143):
            verba INDENIZATÓRIA. NÃO incide INSS (Lei 8.212/91 art. 28 §9º
            "e" 6), IRRF nem FGTS. Fica na categoria PROV_INDENIZ, fora do
            GROSS e de qualquer base, mas somada ao NET.
          - 1/3 constitucional SOBRE O ABONO, pago na vigência do contrato:
            É TRIBUTÁVEL pelo IRRF (Solução de Consulta COSIT nº 209/2021).
            Continua SEM INSS e SEM FGTS. Por isso fica em categoria própria
            (PROV_TRIB_IRRF): entra na base do IRRF, mas não no GROSS, que é
            a base de INSS e FGTS.
            A isenção do ADI SRF 5/2005 alcança o 1/3 de férias INDENIZADAS
            NA RESCISÃO - não o 1/3 do abono do art. 143 com contrato ativo.
          - Ao vender 10 dias, o empregado GOZA 20 dias: as férias gozadas
            são proporcionais (20/30) via l10n_br_dias_ferias_gozadas.
          - IRRF apurado EM SEPARADO dos demais rendimentos do mês (IN RFB
            1.500/2014, art. 29, § 1º): garantido pela estrutura/holerite
            próprios de férias, com GROSS, BASE_IRRF e IRRF exclusivos deste
            holerite.

        PENSÃO ALIMENTÍCIA NAS APURAÇÕES SEPARADAS (RF-03) - regra adotada,
        válida também para o 13º e para a rescisão:

          1. Só se DEDUZ da base do IRRF a pensão que é EFETIVAMENTE RETIDA
             neste holerite. A dedução do art. 4º II da Lei 9.250/95 pressupõe
             importância PAGA a título de pensão; reduzir a base sem retenção
             (comportamento anterior) inventava dedução e subtributava.
             Lastro direto: IN RFB 1.500/2014, art. 13, § 6º, I, que só admite
             as deduções "desde que correspondam a esse rendimento" e veda usar
             o mesmo valor em outra base de cálculo; e art. 29, § 3º, que na
             base das férias remete às deduções do art. 52 "correspondentes às
             férias".
          2. Parcela FIXA: obrigação MENSAL, quitada UMA única vez por mês, na
             folha mensal (rubrica PENSAO_ALIMENTICIA de l10n_br_hr_payroll).
             NÃO é replicada no holerite de férias nem no do 13º, porque
             replicar desconta duas vezes do empregado e usa a mesma
             importância em duas bases, o que o art. 13, § 6º, I veda
             expressamente.
          3. Parcela PERCENTUAL: incide sobre a própria verba desta apuração
             (férias + 1/3 aqui; 13º bruto no holerite do 13º), acompanhando o
             entendimento consolidado de que o percentual fixado em juízo
             alcança férias, terço constitucional e gratificação natalina.
             Como a base é a verba deste holerite, não há sobreposição com o
             percentual retido na folha mensal (que incide sobre o salário do
             mês).
          4. EXCEÇÃO da rescisão: lá não existe folha mensal, e o saldo de
             salário faz o papel da remuneração do mês - por isso a parcela
             fixa é retida no saldo de salário (ver hr_salary_rule_rescisao).
    -->

    <!-- Categoria de proventos indenizatórios (fora de todas as bases) -->
    <record id="hr_salary_rule_category_prov_indeniz" model="hr.salary.rule.category">
        <field name="name">Provento Indenizatório</field>
        <field name="code">PROV_INDENIZ</field>
    </record>

    <!-- Categoria de proventos tributáveis SOMENTE pelo IRRF (sem INSS/FGTS) -->
    <record id="hr_salary_rule_category_prov_trib_irrf" model="hr.salary.rule.category">
        <field name="name">Provento Tributável Apenas pelo IRRF</field>
        <field name="code">PROV_TRIB_IRRF</field>
    </record>

    <!-- Férias gozadas (proporcional aos dias efetivamente gozados) -->
    <record id="hr_rule_ferias" model="hr.salary.rule">
        <field name="name">Férias</field>
        <field name="sequence" eval="1" />
        <field name="code">FERIAS</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_basic"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Férias proporcionais aos dias gozados: ao vender o abono (10 dias), o
# empregado goza 20 dias => 20/30 do salário (CLT art. 143).
dias_gozados = payslip.l10n_br_dias_ferias_gozadas
result = tools.br.round_money(contract.wage * dias_gozados / 30)
        </field>
    </record>

    <!-- Adicional de Férias (1/3 constitucional sobre as férias gozadas) -->
    <record id="hr_rule_adicional_ferias" model="hr.salary.rule">
        <field name="name">Adicional de Férias (1/3)</field>
        <field name="sequence" eval="2" />
        <field name="code">ADICIONAL_FERIAS</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_alw"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = tools.br.round_money(FERIAS / 3)
        </field>
    </record>

    <!-- Abono Pecuniário (venda de 1/3 das férias) - INDENIZATÓRIO -->
    <record id="hr_rule_abono_pecuniario" model="hr.salary.rule">
        <field name="name">Abono Pecuniário</field>
        <field name="sequence" eval="3" />
        <field name="code">ABONO_PECUNIARIO</field>
        <field name="category_id" ref="hr_salary_rule_category_prov_indeniz" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = payslip.l10n_br_abono_pecuniario
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Dias vendidos = 30 - dias gozados (10 dias quando vende 1/3).
dias_vendidos = 30 - payslip.l10n_br_dias_ferias_gozadas
result = tools.br.round_money((contract.wage / 30) * dias_vendidos)
        </field>
    </record>

    <!-- 1/3 constitucional sobre o abono pecuniário - TRIBUTÁVEL PELO IRRF
         (Solução de Consulta COSIT nº 209/2021), sem INSS e sem FGTS. -->
    <record id="hr_rule_adicional_abono" model="hr.salary.rule">
        <field name="name">Adicional sobre Abono (1/3)</field>
        <field name="sequence" eval="4" />
        <field name="code">ADICIONAL_ABONO</field>
        <field name="category_id" ref="hr_salary_rule_category_prov_trib_irrf" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = payslip.l10n_br_abono_pecuniario
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = tools.br.round_money(ABONO_PECUNIARIO / 3)
        </field>
    </record>

    <!-- GROSS para férias (apenas verbas TRIBUTÁVEIS: férias gozadas + 1/3) -->
    <record id="hr_rule_gross_ferias" model="hr.salary.rule">
        <field name="name">Remuneração Bruta (Férias)</field>
        <field name="sequence" eval="99" />
        <field name="code">GROSS</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_gross"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.BASIC + categories.ALW
        </field>
    </record>

    <!-- INSS sobre férias (só verbas tributáveis) -->
    <record id="hr_rule_inss_ferias" model="hr.salary.rule">
        <field name="name">INSS (Férias)</field>
        <field name="sequence" eval="100" />
        <field name="code">INSS</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = tools.br.calc_inss(max(categories.GROSS, 0))
        </field>
    </record>

    <!-- Pensão alimentícia retida sobre as férias (RF-03).
         SOMENTE a parcela percentual: a parcela fixa é obrigação mensal e já
         é descontada na folha mensal (ver cabeçalho, item 2). -->
    <record id="hr_rule_pensao_ferias" model="hr.salary.rule">
        <field name="name">Pensão Alimentícia (Férias)</field>
        <field name="sequence" eval="106" />
        <field name="code">PENSAO_ALIMENTICIA</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = employee.l10n_br_pensao_percentual &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Percentual sobre a remuneração de férias (férias gozadas + 1/3 = GROSS).
# O abono pecuniário e o seu 1/3 ficam FORA: são verbas indenizatórias, cuja
# inclusão na pensão depende de decisão judicial específica (não presumir).
# valor_fixo = 0.0: parcela fixa é mensal e não se repete aqui.
result = tools.br.calc_pensao_alimenticia(
    categories.GROSS,
    0.0,
    employee.l10n_br_pensao_percentual,
)
        </field>
    </record>

    <!-- Base IRRF férias -->
    <record id="hr_rule_base_irrf_ferias" model="hr.salary.rule">
        <field name="name">Base IRRF (Férias)</field>
        <field name="sequence" eval="110" />
        <field name="code">BASE_IRRF</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_info"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Rendimento tributável do holerite de férias = férias gozadas + 1/3 (GROSS)
# MAIS o 1/3 constitucional sobre o abono pecuniário, que é tributável pelo
# IRRF (COSIT 209/2021) apesar de não sofrer INSS nem FGTS.
rendimento = categories.GROSS + categories.PROV_TRIB_IRRF
deducoes = INSS
# Dedução por dependente concedida também nesta apuração, mesmo quando há
# folha mensal no mesmo mês: prática de mercado sem dispositivo expresso; no
# 13º a duplicidade é autorizada (MAFON 2025, alínea e.1), nas férias decorre
# da remissão do art. 29, § 3º da IN RFB 1.500/2014 ao art. 52. Diferente da
# pensão, cuja parcela fixa NÃO se repete, porque ali o art. 13, § 6º, I veda
# usar a mesma importância em duas bases.
dependentes = employee.l10n_br_irrf_dependentes * tools.br.irrf_deducao_dependente()
# Só a pensão EFETIVAMENTE RETIDA neste holerite reduz a base (ver cabeçalho).
pensao = PENSAO_ALIMENTICIA
result = rendimento - deducoes - dependentes - pensao
        </field>
    </record>

    <!-- IRRF sobre férias (apuração em separado do salário do mês) -->
    <record id="hr_rule_irrf_ferias" model="hr.salary.rule">
        <field name="name">IRRF (Férias)</field>
        <field name="sequence" eval="120" />
        <field name="code">IRRF</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = not employee.l10n_br_molestia_grave
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# RF-16: a apuração das férias também segue a forma MAIS FAVORÁVEL: dedução
# legal (BASE_IRRF) x desconto simplificado, sobre o rendimento tributável
# desta apuração. O desconto simplificado nas férias tem dispositivo próprio:
# IN RFB 1.500/2014, art. 29, § 5º (incluído pela IN RFB 2.141/2023), que
# reproduz na base das férias a opção do art. 4º, § 2º da Lei 9.250/95.
# O redutor do IRPF (Lei 9.250/95, art. 3º-A, caput, incluído pela Lei
# 15.270/2025, desde 01/2026) entra depois, sobre o rendimento BRUTO: aqui por
# subsunção ao caput, que não menciona as férias em separado.
# Antes só existia o caminho da dedução legal, com risco de retenção A MAIOR.
rendimento = max(categories.GROSS + categories.PROV_TRIB_IRRF, 0)
result = tools.br.irrf_mais_favoravel(rendimento, BASE_IRRF)
        </field>
    </record>

    <!-- FGTS sobre férias (8% das verbas tributáveis: férias gozadas + 1/3) -->
    <record id="hr_rule_fgts_ferias" model="hr.salary.rule">
        <field name="name">FGTS (Férias)</field>
        <field name="sequence" eval="150" />
        <field name="code">FGTS</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_comp"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = employee.l10n_br_tipo_contrato != 'aprendiz'
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = tools.br.round_money(max(categories.GROSS, 0) * 0.08)
        </field>
    </record>

    <!-- NET férias (inclui indenizatórios e o 1/3 do abono; COMP não afeta) -->
    <record id="hr_rule_net_ferias" model="hr.salary.rule">
        <field name="name">Líquido (Férias)</field>
        <field name="sequence" eval="200" />
        <field name="code">NET</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_net"
        />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    categories.BASIC
    + categories.ALW
    + categories.PROV_INDENIZ
    + categories.PROV_TRIB_IRRF
    - categories.DED
)
        </field>
    </record>
</odoo>
