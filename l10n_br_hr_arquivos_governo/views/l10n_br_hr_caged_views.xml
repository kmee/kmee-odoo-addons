<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_hr_caged_form" model="ir.ui.view">
        <field name="name">l10n_br.hr.caged.form</field>
        <field name="model">l10n_br.hr.caged</field>
        <field name="arch" type="xml">
            <form string="CAGED">
                <header>
                    <button
                        name="action_gerar_caged"
                        string="Gerar CAGED (descontinuado)"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_sent"
                        string="Marcar como Enviado"
                        type="object"
                        invisible="state != 'open'"
                    />
                    <button
                        name="action_draft"
                        string="Voltar para Rascunho"
                        type="object"
                        invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>CAGED extinto.</strong> Pela Portaria SEPRT
                        1.127/2019, quem presta informa&#231;&#245;es pelo eSocial est&#225;
                        dispensado do CAGED desde janeiro de 2020: as
                        movimenta&#231;&#245;es v&#227;o pelos eventos S-2200 (admiss&#227;o) e
                        S-2299 (desligamento). A gera&#231;&#227;o de arquivo est&#225;
                        desativada; esta tela serve apenas para consultar o
                        hist&#243;rico j&#225; gerado.
                    </div>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="mes" />
                            <field name="ano" />
                            <field name="primeira_declaracao" />
                        </group>
                        <group>
                            <field name="responsavel" />
                            <field name="cpf_responsavel" />
                            <field name="email_responsavel" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimenta&#231;&#245;es">
                            <field name="contract_ids" />
                        </page>
                        <page string="Arquivo CAGED">
                            <field name="file_binary" filename="file_name" />
                            <field name="file_name" invisible="1" />
                            <field name="file_content" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_hr_caged_tree" model="ir.ui.view">
        <field name="name">l10n_br.hr.caged.list</field>
        <field name="model">l10n_br.hr.caged</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="mes" />
                <field name="ano" />
                <field name="company_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="l10n_br_hr_caged_action" model="ir.actions.act_window">
        <field name="name">CAGED</field>
        <field name="res_model">l10n_br.hr.caged</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
