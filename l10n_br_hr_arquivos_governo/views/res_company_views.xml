<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_company_form_governo" model="ir.ui.view">
        <field name="name">res.company.form.governo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Arquivos Governo (Folha)">
                    <group>
                        <group string="SEFIP / FGTS">
                            <field name="l10n_br_codigo_fpas" />
                            <field name="l10n_br_codigo_outras_entidades" />
                            <field name="l10n_br_codigo_recolhimento_gps" />
                            <field name="l10n_br_centralizadora" />
                            <field name="l10n_br_porcentagem_filantropia" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
