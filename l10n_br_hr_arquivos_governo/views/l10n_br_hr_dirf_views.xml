<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_hr_dirf_form" model="ir.ui.view">
        <field name="name">l10n_br.hr.dirf.form</field>
        <field name="model">l10n_br.hr.dirf</field>
        <field name="arch" type="xml">
            <form string="DIRF">
                <header>
                    <button
                        name="action_buscar_funcionarios"
                        string="Buscar Funcionários"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_gerar_dirf"
                        string="Gerar DIRF (descontinuado)"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_sent"
                        string="Marcar como Enviado"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'open')]}"
                    />
                    <button
                        name="action_draft"
                        string="Voltar para Rascunho"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>DIRF extinta.</strong> A IN RFB 2.181/2024
                        encerrou a DIRF: os fatos ocorridos a partir de
                        01/01/2025 são informados pela EFD-Reinf (série R-4000)
                        e pelo eSocial, com confissão e recolhimento na DCTFWeb.
                        A geração de arquivo está desativada; esta tela serve
                        apenas para consultar o histórico já gerado.
                    </div>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="ano_referencia" />
                            <field name="ano_calendario" />
                        </group>
                        <group>
                            <field name="retificadora" />
                            <field
                                name="numero_recibo"
                                attrs="{'invisible': [('retificadora', '=', False)]}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Funcionários">
                            <field name="employee_ids" />
                        </page>
                        <page string="Arquivo DIRF">
                            <field name="file_binary" filename="file_name" />
                            <field name="file_name" invisible="1" />
                            <field name="file_content" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_hr_dirf_tree" model="ir.ui.view">
        <field name="name">l10n_br.hr.dirf.tree</field>
        <field name="model">l10n_br.hr.dirf</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="ano_referencia" />
                <field name="company_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_hr_dirf_action" model="ir.actions.act_window">
        <field name="name">DIRF</field>
        <field name="res_model">l10n_br.hr.dirf</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
