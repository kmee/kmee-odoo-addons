<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_br_hr_dirf_form" model="ir.ui.view">
        <field name="name">l10n_br.hr.dirf.form</field>
        <field name="model">l10n_br.hr.dirf</field>
        <field name="arch" type="xml">
            <form string="DIRF">
                <header>
                    <button
                        name="action_buscar_funcionarios"
                        string="Buscar Funcion&#225;rios"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_gerar_dirf"
                        string="Gerar DIRF (descontinuado)"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_sent"
                        string="Marcar como Enviado"
                        type="object"
                        invisible="state != 'open'"
                    />
                    <button
                        name="action_draft"
                        string="Voltar para Rascunho"
                        type="object"
                        invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>DIRF extinta.</strong> A IN RFB 2.181/2024
                        encerrou a DIRF: os fatos ocorridos a partir de
                        01/01/2025 s&#227;o informados pela EFD-Reinf (s&#233;rie R-4000)
                        e pelo eSocial, com confiss&#227;o e recolhimento na DCTFWeb.
                        A gera&#231;&#227;o de arquivo est&#225; desativada; esta tela serve
                        apenas para consultar o hist&#243;rico j&#225; gerado.
                    </div>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="ano_referencia" />
                            <field name="ano_calendario" />
                        </group>
                        <group>
                            <field name="retificadora" />
                            <field name="numero_recibo" invisible="not retificadora" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Funcion&#225;rios">
                            <field name="employee_ids" />
                        </page>
                        <page string="Arquivo DIRF">
                            <field name="file_binary" filename="file_name" />
                            <field name="file_name" invisible="1" />
                            <field name="file_content" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_br_hr_dirf_tree" model="ir.ui.view">
        <field name="name">l10n_br.hr.dirf.list</field>
        <field name="model">l10n_br.hr.dirf</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="ano_referencia" />
                <field name="company_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="l10n_br_hr_dirf_action" model="ir.actions.act_window">
        <field name="name">DIRF</field>
        <field name="res_model">l10n_br.hr.dirf</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
