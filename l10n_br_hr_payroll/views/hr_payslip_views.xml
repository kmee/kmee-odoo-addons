<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_payslip_form_br" model="ir.ui.view">
        <field name="name">hr.payslip.form.br</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='input']" position="after">
                <page string="Dados BR" name="payroll_br_data">
                    <group>
                        <group string="Horas Extras">
                            <field name="l10n_br_horas_extras_50" />
                            <field name="l10n_br_horas_extras_100" />
                        </group>
                        <group string="Adicional Noturno">
                            <field name="l10n_br_horas_noturnas" />
                            <field name="l10n_br_usar_hora_reduzida" />
                            <field name="l10n_br_horas_noturnas_computadas" />
                        </group>
                        <group string="Faltas">
                            <field name="l10n_br_faltas_injustificadas" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
