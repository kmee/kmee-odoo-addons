<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Parâmetros de encargos patronais da empresa (RF-31/RF-32/RF-33).

        O REGIME tributário em si não é editado aqui: fica na aba fiscal
        (tax_framework/profit_calculation do l10n_br_fiscal), que é a fonte
        única. Esta aba só reúne o que a folha acrescenta.
    -->
    <record id="view_res_company_form_payroll_br" model="ir.ui.view">
        <field name="name">res.company.form.payroll.br</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="l10n_br_hr_encargos"
                    string="Encargos da Folha"
                    attrs="{'invisible': [('country_id', '!=', %(base.br)d)]}"
                >
                    <group>
                        <group string="Regime Tributário (somente leitura)">
                            <field name="tax_framework" readonly="1" />
                            <field name="profit_calculation" readonly="1" />
                            <field
                                name="l10n_br_hr_simples_anexo"
                                attrs="{'invisible': [('tax_framework', 'not in', ['1', '2', '4'])]}"
                            />
                        </group>
                        <group string="RAT / FAP (eSocial S-1005)">
                            <field name="l10n_br_hr_rat" />
                            <field name="l10n_br_hr_fap" />
                            <field name="l10n_br_hr_rat_ajustado" />
                        </group>
                        <group string="Lotação Padrão (eSocial S-1020)">
                            <field name="l10n_br_hr_fpas_padrao" />
                            <field name="l10n_br_hr_terceiros_padrao" />
                        </group>
                        <group string="Desoneração da Folha (CPRB)">
                            <field name="l10n_br_hr_cprb_optante" />
                            <field
                                name="l10n_br_hr_cprb_perc_contrib_nao_desonerada"
                                attrs="{'invisible': [('l10n_br_hr_cprb_optante', '=', False)]}"
                            />
                        </group>
                        <group string="Provisões">
                            <field name="l10n_br_hr_prov_ferias_perc_indenizado" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
