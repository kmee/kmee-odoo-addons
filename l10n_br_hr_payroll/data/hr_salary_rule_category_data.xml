<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Categorias base (criadas caso demo do OCA payroll não esteja carregado) -->
    <record id="hr_salary_rule_category_basic" model="hr.salary.rule.category">
        <field name="name">Salário Base</field>
        <field name="code">BASIC</field>
    </record>
    <record id="hr_salary_rule_category_alw" model="hr.salary.rule.category">
        <field name="name">Provento</field>
        <field name="code">ALW</field>
    </record>
    <record id="hr_salary_rule_category_gross" model="hr.salary.rule.category">
        <field name="name">Remuneração Bruta</field>
        <field name="code">GROSS</field>
    </record>
    <record id="hr_salary_rule_category_ded" model="hr.salary.rule.category">
        <field name="name">Desconto</field>
        <field name="code">DED</field>
    </record>
    <record id="hr_salary_rule_category_net" model="hr.salary.rule.category">
        <field name="name">Líquido</field>
        <field name="code">NET</field>
    </record>
    <record id="hr_salary_rule_category_comp" model="hr.salary.rule.category">
        <field name="name">Encargos Patronais</field>
        <field name="code">COMP</field>
    </record>
    <!-- Categoria informativa para valores intermediários -->
    <record id="hr_salary_rule_category_info" model="hr.salary.rule.category">
        <field name="name">Informativo</field>
        <field name="code">INFO</field>
    </record>
</odoo>
