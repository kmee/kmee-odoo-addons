        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_employee_ppe.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="is_ppe" position="after">
                <field name="l10n_br_sst_ca_id" />
                <field
                    name="l10n_br_sst_ca_validade"
                    attrs="{'invisible': [('l10n_br_sst_ca_id', '=', False)]}"
                />
                <field
                    name="l10n_br_sst_ca_state"
                    attrs="{'invisible': [('l10n_br_sst_ca_id', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
