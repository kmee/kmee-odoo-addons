<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="task_throughput_report_view_graph" model="ir.ui.view">
            <field name="name">task.throughput.report.graph</field>
            <field name="model">task.throughput.report</field>
            <field name="arch" type="xml">
                <graph string="Task Throughput Analysis" sample="1">
                    <field name="date" interval="week" />
                </graph>
            </field>
        </record>

        <record id="task_throughput_report_view_pivot" model="ir.ui.view">
            <field name="name">task.throughput.report.pivot</field>
            <field name="model">task.throughput.report</field>
            <field name="arch" type="xml">
                <pivot string="Task Throughput Analysis" sample="1">
                    <field name="date" interval="week" type="row" />
                </pivot>
            </field>
        </record>

        <record id="task_throughput_report_view_tree" model="ir.ui.view">
            <field name="name">task.throughput.report.tree</field>
            <field name="model">task.throughput.report</field>
            <field name="arch" type="xml">
                <tree default_order="date desc">
                    <field name="date" />
                    <field name="project_id" />
                    <field name="milestone_id" />
                    <field name="in_qty" />
                    <field name="out_qty" />
                </tree>
            </field>
        </record>

        <record id="task_throughput_report_view_search" model="ir.ui.view">
            <field name="name">task.throughput.report.search</field>
            <field name="model">task.throughput.report</field>
            <field name="arch" type="xml">
                <search string="Task Throughput Analysis">
                    <field name="project_id" string="Project" />
                    <field name="milestone_id" string="milestone_id" />
                    <separator />
                    <filter
                    name="last_24h"
                    string="Last 24h"
                    domain="[('date','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d') )]"
                />
                    <filter
                    string="Last Week"
                    invisible="1"
                    name="last_week"
                    domain="[('date','&gt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                    <filter
                    string="Last Month"
                    invisible="1"
                    name="last_month"
                    domain="[('date','&gt;', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                    <filter
                    string="Last Year"
                    invisible="1"
                    name="last_year"
                    domain="[('date','&gt;', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d'))]"
                />
                    <filter name="filter_date" date="date" />
                    <separator />
                    <!-- <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/> -->
                    <group expand="1" string="Group By">
                        <filter
                        string="Project"
                        name="group_by_project_id"
                        context="{'group_by': 'project_id'}"
                    />
                        <filter
                        string="Milestone"
                        name="group_by_milestone_id"
                        context="{'group_by': 'milestone_id'}"
                    />
                        <separator />
                        <filter
                        string="Date"
                        name="group_by_day_date"
                        context="{'group_by': 'date:day'}"
                    />
                    </group>
                </search>
            </field>
        </record>

       <record id="task_throughput_report_action" model="ir.actions.act_window">
           <field name="name">Task Throughput</field>
           <field name="res_model">task.throughput.report</field>
           <field name="view_mode">pivot,tree</field>
           <field name="context">{
            'group_by': [], 'pivot_measures': ['out_qty', 'in_qty'], 'pivot_column_groupby': [], 'pivot_row_groupby': ['date:week']}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No data yet!
                </p>
            </field>
       </record>

        <record model="ir.ui.menu" id="project_task_throughput_menu">
            <field name="name">Task Throughput</field>
            <field name="parent_id" ref="project.menu_project_report" />
            <field name="action" ref="task_throughput_report_action" />
            <field name="sequence" eval="100" />
        </record>

</odoo>
