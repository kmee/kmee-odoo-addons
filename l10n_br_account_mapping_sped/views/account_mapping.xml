<odoo>

    <record id="mapping_plan_form_sped" model="ir.ui.view">
        <field name="name">l10n_br_account_mapping.plan.form.sped</field>
        <field name="model">l10n_br_account_mapping.plan</field>
        <field name="inherit_id" ref="l10n_br_account_mapping.mapping_plan_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="sped_referential" />
                <field
                    name="sped_plan_code"
                    invisible="not sped_referential"
                    required="sped_referential"
                />
            </field>
        </field>
    </record>

</odoo>
