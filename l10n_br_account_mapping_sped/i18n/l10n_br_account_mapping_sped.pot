#. module: l10n_br_account_mapping_sped
#: model:ir.module.module,description:base.module_l10n_br_account_mapping_sped
msgid ""
"===============================\n"
"Plano Referencial da RFB (SPED)\n"
"===============================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
"   !! changes will be overwritten.                   !!\n"
