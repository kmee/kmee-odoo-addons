<odoo>

    <record id="history_venda" model="l10n_br.account.history">
        <field name="name">Venda de mercadoria</field>
        <field name="template">Venda cf. doc. %{DOC} a %{PARCEIRO}</field>
        <field name="code">1</field>
    </record>

    <record id="history_imposto" model="l10n_br.account.history">
        <field name="name">Apropriacao de imposto</field>
        <field name="template">%{CAMPO} s/ doc. %{DOC} de %{MM}/%{AAAA}</field>
        <field name="code">30</field>
    </record>

</odoo>
