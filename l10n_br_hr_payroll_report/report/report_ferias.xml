<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_recibo_ferias">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .ferias-table { width: 100%; border-collapse: collapse; font-size: 10px; }
                            .ferias-table td, .ferias-table th { border: 1px solid #333; padding: 2px 4px; }
                            .ferias-header { background-color: #e9e9e9; font-weight: bold; }
                            .ferias-title { font-size: 12px; font-weight: bold; text-align: center; padding: 4px; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .ferias-totals td { font-weight: bold; background-color: #f5f5f5; }
                        </style>

                        <!-- CABEÇALHO -->
                        <table class="ferias-table">
                            <tr>
                                <td colspan="4" class="ferias-title">
                                    RECIBO DE FÉRIAS
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">
                                    <strong>Empresa:</strong>
                                    <span t-field="o.company_id.name" />
                                </td>
                                <td>
                                    <strong>CNPJ:</strong>
                                    <span t-field="o.company_id.cnpj_cpf" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- DADOS DO EMPREGADO -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td colspan="4">DADOS DO EMPREGADO</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Nome:</strong>
                                    <span t-field="o.employee_id.name" />
                                </td>
                                <td>
                                    <strong>CPF:</strong>
                                    <span t-field="o.employee_id.cnpj_cpf" />
                                </td>
                                <td>
                                    <strong>CTPS:</strong>
                                    <span t-field="o.employee_id.ctps" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Cargo:</strong>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                                <td colspan="2">
                                    <strong>Depto:</strong>
                                    <span t-field="o.employee_id.department_id" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- PERÍODO DE FÉRIAS -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td colspan="4">PERÍODO DE FÉRIAS</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Período Aquisitivo:</strong>
                                    <span t-field="o.contract_id.date_start" /> a
                                    <span t-field="o.date_to" />
                                </td>
                                <td colspan="2">
                                    <strong>Período de Gozo:</strong>
                                    <span t-field="o.date_from" /> a
                                    <span t-field="o.date_to" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Admissão:</strong>
                                    <span t-field="o.contract_id.date_start" />
                                </td>
                                <td colspan="2">
                                    <strong>Salário Base:</strong>
                                    <span
                                        t-esc="o.contract_id.wage"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                    />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- PROVENTOS E DESCONTOS -->
                        <t
                            t-set="proventos"
                            t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.total &gt; 0 and l.category_id.code not in ('DED', 'NET', 'INFO', 'COMP'))"
                        />
                        <t
                            t-set="descontos"
                            t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.total &gt; 0 and l.category_id.code == 'DED')"
                        />

                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td style="width:8%;" class="text-center">Cód</td>
                                <td style="width:42%;">Descrição</td>
                                <td style="width:25%;" class="text-right">Proventos</td>
                                <td style="width:25%;" class="text-right">Descontos</td>
                            </tr>

                            <t t-foreach="proventos" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-field="line.code" />
                                    </td>
                                    <td>
                                        <span t-field="line.name" />
                                    </td>
                                    <td class="text-right">
                                        <span
                                            t-esc="line.total"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </td>
                                    <td />
                                </tr>
                            </t>

                            <t t-foreach="descontos" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-field="line.code" />
                                    </td>
                                    <td>
                                        <span t-field="line.name" />
                                    </td>
                                    <td />
                                    <td class="text-right">
                                        <span
                                            t-esc="line.total"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>

                            <t
                                t-set="total_proventos"
                                t-value="sum(proventos.mapped('total'))"
                            />
                            <t
                                t-set="total_descontos"
                                t-value="sum(descontos.mapped('total'))"
                            />
                            <t
                                t-set="line_net"
                                t-value="o.line_ids.filtered(lambda l: l.code == 'NET')[:1]"
                            />
                            <tr class="ferias-totals">
                                <td colspan="2" class="text-center">TOTAIS</td>
                                <td class="text-right">
                                    <span
                                        t-esc="total_proventos"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                    />
                                </td>
                                <td class="text-right">
                                    <span
                                        t-esc="total_descontos"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                    />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- LÍQUIDO -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td class="text-center">LÍQUIDO A RECEBER</td>
                            </tr>
                            <tr>
                                <td class="text-right" style="font-size: 12px;">
                                    <strong>
                                        <span
                                            t-esc="line_net.total if line_net else 0.0"
                                            t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                        />
                                    </strong>
                                </td>
                            </tr>
                        </table>

                        <br />
                        <br />

                        <!-- DECLARAÇÃO -->
                        <p style="font-size: 10px;">
                            Declaro que recebi a importância líquida acima discriminada,
                            referente às férias indicadas neste recibo, dando plena e
                            irrevogável quitação.
                        </p>

                        <br />
                        <br />

                        <!-- ASSINATURAS -->
                        <table style="width:100%;">
                            <tr>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Empregador
                                </td>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Empregado
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
