<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_expense_sheet_form_inherit" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.ressarcimento</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_mode']" position="after">
                <field
                    name="l10n_br_refund_in_payslip"
                    attrs="{'invisible': [('payment_mode', '!=', 'own_account')]}"
                />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field
                    name="l10n_br_payslip_id"
                    attrs="{'invisible': [('l10n_br_payslip_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
