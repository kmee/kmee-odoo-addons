<odoo>
    <record id="payment_provider_form_pinbank" model="ir.ui.view">
        <field name="name">Pinbank Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group name="pinbank_credentials" invisible="code != 'boleto_pinbank'">
                    <field
                        name="pinbank_user"
                        required="code == 'boleto_pinbank' and state != 'disabled'"
                    />
                    <field
                        name="pinbank_secret"
                        required="code == 'boleto_pinbank' and state != 'disabled'"
                        password="True"
                    />
                    <field
                        name="pinbank_channel"
                        required="code == 'boleto_pinbank' and state != 'disabled'"
                    />
                    <field
                        name="pinbank_client"
                        required="code == 'boleto_pinbank' and state != 'disabled'"
                    />
                    <field
                        name="pinbank_request_origin"
                        required="code == 'boleto_pinbank' and state != 'disabled'"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
