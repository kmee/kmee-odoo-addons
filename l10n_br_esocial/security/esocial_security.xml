<odoo noupdate="1">
    <!-- Os eventos carregam CPF e remuneração por trabalhador: cada usuário só
         enxerga os da(s) empresa(s) em que está habilitado. -->
    <record id="rule_esocial_evento_multi_company" model="ir.rule">
        <field name="name">eSocial evento: multi-empresa</field>
        <field name="model_id" ref="model_l10n_br_esocial_evento" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
