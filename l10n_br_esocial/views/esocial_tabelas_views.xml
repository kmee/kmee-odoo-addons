<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ===== Natureza Rubrica (Tab 3) ===== -->
    <record id="view_esocial_natureza_rubrica_tree" model="ir.ui.view">
        <field name="name">l10n_br.esocial.natureza.rubrica.tree</field>
        <field name="model">l10n_br.esocial.natureza.rubrica</field>
        <field name="arch" type="xml">
            <tree>
                <field name="codigo" />
                <field name="nome" />
            </tree>
        </field>
    </record>

    <record id="view_esocial_natureza_rubrica_form" model="ir.ui.view">
        <field name="name">l10n_br.esocial.natureza.rubrica.form</field>
        <field name="model">l10n_br.esocial.natureza.rubrica</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="codigo" />
                        <field name="nome" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esocial_natureza_rubrica" model="ir.actions.act_window">
        <field name="name">Natureza da Rubrica (Tab. 3)</field>
        <field name="res_model">l10n_br.esocial.natureza.rubrica</field>
        <field name="view_mode">tree,form</field>
    </record>

