        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="codigo" />
                        <field name="nome" />
                        <field name="dt_inicio" />
                        <field name="dt_fim" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

