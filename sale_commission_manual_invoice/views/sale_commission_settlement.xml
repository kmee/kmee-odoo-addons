<odoo>
    <record id="view_settlement_form_manual_invoice" model="ir.ui.view">
        <field name="name">commission.settlement.form.manual.invoice</field>
        <field name="model">commission.settlement</field>
        <field name="inherit_id" ref="account_commission.view_settlement_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">settled,invoiced,paid,except_invoice,cancel</attribute>
            </xpath>
            <xpath expr="//button[@name='action_invoice']" position="replace"/>
            <xpath expr="//button[@name='action_draft']" position="replace"/>
            <xpath expr="//field[@name='state']" position="after">
                <button
                    name="action_mark_invoiced"
                    string="Mark as Invoiced"
                    type="object"
                    class="oe_highlight"
                    groups="account.group_account_invoice"
                    states="settled,except_invoice"
                />
                <button
                    name="action_confirm"
                    string="Mark as Paid"
                    type="object"
                    class="oe_highlight"
                    groups="account.group_account_invoice"
                    states="invoiced"
                />
                <button
                    name="action_except_invoice"
                    string="Invoice Exception"
                    type="object"
                    groups="account.group_account_invoice"
                    states="settled,invoiced"
                />
                <button
                    name="action_settle"
                    string="Set to Settled"
                    type="object"
                    groups="account.group_account_invoice"
                    states="paid,invoiced,except_invoice,cancel"
                />
            </xpath>
        </field>
    </record>

    <record id="account_commission.menu_invoicing_settlements" model="ir.ui.menu">
        <field name="active">False</field>
    </record>
</odoo>
