<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="account_payment_installments_inherit_form" model="ir.ui.view">
        <field name="name">account.payment.installments.inherit.form</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form" />
        <field name="arch" type="xml">
            <field name="note" position="before">
                <field name="is_installment" />
            </field>
            <field name="display_on_invoice" position="after">
                <group
                    name="provider"
                    string="Informações do Parcelamento"
                    attrs="{'invisible': [('is_installment', '!=', True)]}"
                >
                    <field name="payment_term_id" />
                    <field name="provider_id" />
                    <field name="installment_type" />
                    <field name="installment_rate" />
                </group>
            </field>
        </field>
    </record>
</odoo>
