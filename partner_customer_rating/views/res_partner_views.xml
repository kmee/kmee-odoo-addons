<odoo>
    <record id="view_partner_form_custom" model="ir.ui.view">
        <field name="name">res.partner.form.customer.rating</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="customer_rating_id" options="{'no_open': True}" />
            </xpath>

            <xpath expr="//div[@class='oe_title mb24']/h1" position="attributes">
                <attribute name="class">d-flex align-items-center gap-2</attribute>
            </xpath>

            <xpath expr="//div[@class='oe_title mb24']/h1/field[1]" position="before">
                <field
                    name="image_rating"
                    widget="image"
                    class="customer-rating-icon"
                />
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_custom" model="ir.ui.view">
        <field name="name">res.partner.tree.customer.rating</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='translated_display_name']" position="before">
                <field
                    name="image_rating"
                    widget="image"
                    class="customer-rating-icon"
                />
            </xpath>
        </field>
    </record>

    <record id="res_partner_kanban_view" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('oe_kanban_partner_categories')]"
                position="inside"
            >
                <span>
                    <field
                        name="image_rating"
                        widget="image"
                        class="customer-rating-icon"
                    />
                </span>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                    name="customer_rating_id"
                    string="Customer Rating"
                    domain="[]"
                    context="{'group_by' : 'customer_rating_id'}"
                />
                <separator />
            </xpath>
        </field>
    </record>
</odoo>
