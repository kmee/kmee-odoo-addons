<odoo>
    <record id="view_customer_rating_form" model="ir.ui.view">
        <field name="name">customer.rating.form</field>
        <field name="model">customer.rating</field>
        <field name="arch" type="xml">
            <form string="Customer Rating">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image" class="customer-rating-icon" options="{'preview_image': 'image'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_rating_tree" model="ir.ui.view">
        <field name="name">customer.rating.tree</field>
        <field name="model">customer.rating</field>
        <field name="arch" type="xml">
            <tree string="Customer Ratings">
                <field name="name"/>
                <field name="image" widget="image" class="customer-rating-icon" options="{'preview_image': 'image'}"/>
            </tree>
        </field>
    </record>

    <record id="rating_rating_action" model="ir.actions.act_window">
        <field name="name">Customer Ratings</field>
        <field name="res_model">customer.rating</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie diferentes níveis de satisfação.
            </p>
        </field>
    </record>

    <menuitem id="menu_customer_rating_root"
              name="Satisfação"
              parent="contacts.res_partner_menu_config"
              sequence="30"
              groups="base.group_user"/>

    <menuitem id="menu_customer_rating"
              name="Níveis de Satisfação"
              parent="menu_customer_rating_root"
              action="rating_rating_action"
              sequence="10"
              groups="base.group_user"/>
</odoo>
