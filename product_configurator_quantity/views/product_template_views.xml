<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== PTAL: Linha de atributo com coluna Qty Required ===== -->
  <record id="view_ptal_qty_tree" model="ir.ui.view">
    <field name="name">product.template.attribute.line.tree.qty</field>
    <field name="model">product.template.attribute.line</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="attribute_id"/>
        <field name="value_ids" widget="many2many_tags"/>
        <field name="is_qty_required"/>
      </tree>
    </field>
  </record>

  <record id="view_ptal_qty_form" model="ir.ui.view">
    <field name="name">product.template.attribute.line.form.qty</field>
    <field name="model">product.template.attribute.line</field>
    <field name="arch" type="xml">
      <form string="Attribute Line">
        <sheet>
          <group>
            <field name="attribute_id" readonly="1"/>
            <field name="value_ids" widget="many2many_tags"/>
            <field name="is_qty_required"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Aplica nossas subviews no O2M attribute_line_ids do template -->
  <record id="product_template_form_inherit_ptal_qty" model="ir.ui.view">
    <field name="name">product.template.form.inherit.ptal.qty</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <!-- prioridade alta para vencer outros inherits -->
    <field name="priority" eval="30"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='attribute_line_ids']" position="attributes">
        <attribute name="views">[(ref('product_configurator_quantity.view_ptal_qty_tree'), 'tree'),
                                 (ref('product_configurator_quantity.view_ptal_qty_form'), 'form')]</attribute>
      </xpath>
    </field>
  </record>

  <!-- ===== PTAV_QTY: Quantidade por valor no template ===== -->
  <record id="view_ptav_qty_tree" model="ir.ui.view">
    <field name="name">product.template.attribute.value.qty.tree</field>
    <field name="model">product.template.attribute.value.qty</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="product_tmpl_id"/>
        <field name="product_attribute_id"/>
        <field name="product_attribute_value_id" domain="[('attribute_id','=', product_attribute_id)]"/>
        <field name="qty"/>
        <field name="qty_min"/>
        <field name="qty_max"/>
      </tree>
    </field>
  </record>

  <record id="view_ptav_qty_form" model="ir.ui.view">
    <field name="name">product.template.attribute.value.qty.form</field>
    <field name="model">product.template.attribute.value.qty</field>
    <field name="arch" type="xml">
      <form string="Quantity per Attribute Value">
        <sheet>
          <group>
            <field name="sequence"/>
            <field name="product_tmpl_id"/>
            <field name="product_attribute_id"/>
            <field name="product_attribute_value_id" domain="[('attribute_id','=', product_attribute_id)]"/>
            <field name="qty"/>
            <field name="qty_min"/>
            <field name="qty_max"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Ação e smartbutton -->
  <record id="action_ptav_qty_for_template" model="ir.actions.act_window">
    <field name="name">Attribute Value Quantities</field>
    <field name="res_model">product.template.attribute.value.qty</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('product_tmpl_id', '=', active_id)]</field>
    <field name="context">{'default_product_tmpl_id': active_id}</field>
    <field name="target">current</field>
  </record>

  <record id="product_template_form_inherit_ptav_qty_button" model="ir.ui.view">
    <field name="name">product.template.form.inherit.ptav.qty.button</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="priority" eval="30"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="action" name="%(action_ptav_qty_for_template)d" icon="fa-sliders">
          <div class="o_stat_info">
            <span class="o_stat_text">Quantidades por Valor</span>
          </div>
        </button>
      </xpath>
    </field>
  </record>

  <record id="product_template_form_inherit_is_qty_required_cfg" model="ir.ui.view">
  <field name="name">product.template.form.inherit.is_qty_required.cfg</field>
  <field name="model">product.template</field>
  <field name="inherit_id" ref="product_configurator.product_template_only_form_view_inherited"/>
  <field name="priority" eval="50"/>
  <field name="arch" type="xml">
    <xpath expr="//field[@name='attribute_line_ids']//tree//field[@name='value_ids']" position="after">
      <field name="is_qty_required" string="Qty Required"/>
    </xpath>
  </field>
</record>

</odoo>