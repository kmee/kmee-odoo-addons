<odoo>
    <record id="crm_case_form_view_oppor_bant_marketing" model="ir.ui.view">
        <field name="name">crm.lead.form.opportunity.bant.marketing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_bant.crm_case_form_view_oppor_bant" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bant_status']" position="after">
                <group string="Marketing">
                    <field
                        name="campaign_id"
                        options="{'create_name_field': 'title', 'always_reload': True}"
                    />
                    <field name="medium_id" />
                    <field name="source_id" />
                    <field name="referred" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
