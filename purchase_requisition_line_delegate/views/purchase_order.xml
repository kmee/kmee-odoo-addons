<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.form (in purchase_requisition_line_delegate)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='price_subtotal']"
                position="after"
            >
                <field name="has_quotation_line" column_invisible="1" />
                <button
                    name="action_view_quotations"
                    title="Has quantities in other quotations and/or orders of the agreement"
                    type="object"
                    icon="fa-shopping-cart"
                    class="text-info"
                    invisible="not has_quotation_line"
                />
            </xpath>
        </field>
    </record>
</odoo>
