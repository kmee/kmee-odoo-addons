<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_monetary_update_index_tree" model="ir.ui.view">
        <field name="name">monetary.update.index.tree</field>
        <field name="model">monetary.update.index</field>
        <field name="arch" type="xml">
            <tree string="Monetary Update Indexes" delete="0" create="0" edit="0">
                <field name="name" />
                <field name="code" />
                <field name="authority" />
                <field name="country_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <!-- Tree View for Managers -->
    <record id="view_monetary_update_index_tree_manager" model="ir.ui.view">
        <field name="name">monetary.update.index.tree.manager</field>
        <field name="model">monetary.update.index</field>
        <field name="inherit_id" ref="view_monetary_update_index_tree" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute
                    name="delete"
                    groups="monetary_update.group_monetary_update_manager"
                >1</attribute>
                <attribute
                    name="create"
                    groups="monetary_update.group_monetary_update_manager"
                >1</attribute>
                <attribute
                    name="edit"
                    groups="monetary_update.group_monetary_update_manager"
                >1</attribute>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_monetary_update_index_form" model="ir.ui.view">
        <field name="name">monetary.update.index.form</field>
        <field name="model">monetary.update.index</field>
        <field name="arch" type="xml">
            <form string="Monetary Update Index" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="code" readonly="1" />
                            <field name="authority" readonly="1" />
                        </group>
                        <group>
                            <field name="country_id" readonly="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="1"
                            />
                            <field name="active" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            readonly="1"
                            placeholder="Enter a detailed description of the index..."
                        />
                    </group>
                    <notebook>
                        <page string="Rates" name="rates">
                            <field name="rate_ids" readonly="1">
                                <tree>
                                    <field name="date" />
                                    <field name="value" />
                                    <field name="source" />
                                    <field name="note" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form View for Managers -->
    <record id="view_monetary_update_index_form_manager" model="ir.ui.view">
        <field name="name">monetary.update.index.form.manager</field>
        <field name="model">monetary.update.index</field>
        <field name="inherit_id" ref="view_monetary_update_index_form" />
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute
                    name="create"
                    groups="monetary_update.group_monetary_update_manager"
                >1</attribute>
                <attribute
                    name="delete"
                    groups="monetary_update.group_monetary_update_manager"
                >1</attribute>
            </form>
            <field name="name" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="code" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="authority" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="country_id" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="company_id" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="active" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="description" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <field name="rate_ids" position="attributes">
                <attribute
                    name="readonly"
                    groups="monetary_update.group_monetary_update_manager"
                >0</attribute>
            </field>
            <tree position="attributes">
                <attribute
                    name="editable"
                    groups="monetary_update.group_monetary_update_manager"
                >bottom</attribute>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_monetary_update_index_search" model="ir.ui.view">
        <field name="name">monetary.update.index.search</field>
        <field name="model">monetary.update.index</field>
        <field name="arch" type="xml">
            <search string="Search Monetary Update Index">
                <field
                    name="name"
                    string="Name or Code"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                />
                <field name="code" />
                <field name="authority" />
                <field name="country_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        string="Country"
                        name="group_by_country"
                        context="{'group_by': 'country_id'}"
                    />
                    <filter
                        string="Authority"
                        name="group_by_authority"
                        context="{'group_by': 'authority'}"
                    />
                    <filter
                        string="Company"
                        name="group_by_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_monetary_update_index" model="ir.actions.act_window">
        <field name="name">Monetary Update Indexes</field>
        <field name="res_model">monetary.update.index</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_monetary_update_index_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Monetary Update Index
            </p>
            <p>
                Monetary update indexes are used to track and apply monetary corrections based on official indexes like SELIC, IPCA, INPC, etc.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_monetary_update_root"
        name="Monetary Indexes"
        parent="base.menu_administration"
        groups="group_monetary_update_manager"
        sequence="100"
    />

    <menuitem
        id="menu_monetary_update_index"
        name="Monetary Update Indexes"
        parent="menu_monetary_update_root"
        action="action_monetary_update_index"
        groups="group_monetary_update_manager"
        sequence="10"
    />

</odoo>
