<odoo>
    <record id="view_update_field_by_index_wizard" model="ir.ui.view">
        <field name="name">update.field.by.index.wizard</field>
        <field name="model">update.field.by.index.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Field by Index Wizard">
                <sheet>
                    <group>
                        <field name="model_id" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="field_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <field name="index_id" />
                        <field name="end_date" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="update_fields_by_index"
                        string="Update Fields"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
