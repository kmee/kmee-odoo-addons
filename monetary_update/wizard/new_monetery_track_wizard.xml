<odoo>
    <record id="view_new_monetery_track_wizard" model="ir.ui.view">
        <field name="name">new.monetery.track.wizard</field>
        <field name="model">new.monetery.track.wizard</field>
        <field name="arch" type="xml">
            <form string="New Monetery Track Wizard">
                <sheet>
                    <group>
                        <field name="model_id" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="field_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <field name="index_id" />
                        <field name="last_update_date" />
                        <field name="end_date" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="create_monetery_track"
                        string="Create Monetary Index Track"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
