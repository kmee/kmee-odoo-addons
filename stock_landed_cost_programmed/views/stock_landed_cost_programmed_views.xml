<odoo>
    <record id="view_stock_landed_cost_form_programmed" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.programmed</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="button_apply_programmed_pickings"
                    string="Apply Programmed Pickings"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible':[('programmed_state','!=','ready')]}"
                />
            </xpath>
            <xpath expr="//field[@name='picking_ids']" position="after">
                <field
                    name="programmed_picking_ids"
                    widget="many2many_tags"
                    domain="[('company_id', '=', company_id)]"
                    options="{'no_create': True}"
                />
                <field name="programmed_state" readonly="1" widget="badge" />
            </xpath>
        </field>
    </record>

    <record id="view_stock_landed_cost_tree_programmed" model="ir.ui.view">
        <field name="name">stock.landed.cost.tree.programmed</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="programmed_state" widget="badge" />
            </xpath>
        </field>
    </record>

</odoo>
