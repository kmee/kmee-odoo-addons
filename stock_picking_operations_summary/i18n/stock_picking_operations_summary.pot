msgid ""
"================================\n"
"Stock Picking Operations Summary\n"
"================================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
"   !! changes will be overwritten.                   !!\n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! source digest: sha256:434d2150f2e3ba12280e3737c4bc36fbbe45f0e237a4c25e26dd69d7a3f0688c\n"
