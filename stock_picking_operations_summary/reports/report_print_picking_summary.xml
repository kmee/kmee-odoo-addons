<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="report_picking_summary" model="ir.actions.report">
        <field name="name">Picking Summary</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >stock_picking_operations_summary.picking_summary</field>
        <field
            name="print_report_name"
        ><![CDATA[
            'Picking Summary - %s - %s' % (object.partner_id.name or '', object.name)]]>
        </field>
        <field
            name="report_file"
        >stock_picking_operations_summary.picking_summary</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
</odoo>
