<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_procurement_button" model="ir.ui.view">
        <field
            name="name"
        >product.template.form (in product_stock_location_info)</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="stock.product_template_form_view_procurement_button"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='stock_property']" position="after">
                <group
                    name="stock_location_info"
                    string="Location"
                    groups="stock.group_stock_user"
                >
                    <field name="stock" string="Stock" />
                    <field name="posx" string="Aisle" />
                    <field name="posy" string="Shelf" />
                    <field name="posz" string="Height" />
                    <field name="box" string="Box" />
                    <field name="caixa" string="Carton" />
                    <field name="nivel" string="Level" />
                </group>
            </xpath>
            <xpath expr="//group[@name='group_lots_and_weight']" position="before">
                <group
                    name="stock_location_info_alternative"
                    string="Alternative Location"
                    groups="stock.group_stock_user"
                >
                    <field name="second_stock" string="Stock" />
                    <field name="second_posx" string="Aisle" />
                    <field name="second_posy" string="Shelf" />
                    <field name="second_posz" string="Height" />
                    <field name="second_box" string="Box" />
                    <field name="second_caixa" string="Carton" />
                    <field name="second_nivel" string="Level" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
