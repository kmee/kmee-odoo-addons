<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_industrialization_set_sale_form" model="ir.ui.view">
        <field name="name">stock.industrialization.set.sale.form</field>
        <field name="model">stock.industrialization.set.sale</field>
        <field name="arch" type="xml">
            <form string="Atribuir a venda">
                <group>
                    <field name="partner_id" />
                    <field name="sale_id" />
                </group>
                <footer>
                    <button
                        name="action_set_sale"
                        type="object"
                        string="Atribuir"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_industrialization_set_sale_action" model="ir.actions.act_window">
        <field name="name">Atribuir a venda</field>
        <field name="res_model">stock.industrialization.set.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
