<odoo>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="l10n_br_jornada" string="Jornada (Portaria 671)">
                    <group>
                        <group string="Controle de jornada">
                            <field name="l10n_br_dispensado_controle_jornada" />
                            <field
                                name="l10n_br_motivo_dispensa_jornada"
                                attrs="{'invisible': [('l10n_br_dispensado_controle_jornada', '=', False)], 'required': [('l10n_br_dispensado_controle_jornada', '=', True)]}"
                            />
                            <field
                                name="l10n_br_registro_por_excecao"
                                attrs="{'invisible': [('l10n_br_dispensado_controle_jornada', '=', True)]}"
                            />
                        </group>
                        <group string="Registrador">
                            <field
                                name="l10n_br_rep_id"
                                attrs="{'invisible': [('l10n_br_dispensado_controle_jornada', '=', True)]}"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
