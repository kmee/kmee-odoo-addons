<odoo>

    <record id="view_sale_blanket_order_wizard_confirm_form" model="ir.ui.view">
        <field name="name">sale.blanket.order.wizard.confirm.form</field>
        <field name="model">sale.blanket.order.wizard.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Order">
                <group>
                    <field name="sale_order_or_blanket_order" widget="radio" />
                </group>
                <footer>
                    <button
                        string="Confirm"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_open_sale_blanket_order_wizard_confirm"
        model="ir.actions.act_window"
    >
        <field name="name">Confirm Order Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.blanket.order.wizard.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
