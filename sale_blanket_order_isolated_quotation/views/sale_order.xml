<odoo>

    <record model="ir.ui.view" id="sale_isolated_quotation.view_order_form">
        <field name="active">False</field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.blanket.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_convert_to_blanket_order"
                    type="object"
                    string="Convert to Blanket Order"
                    class="btn-primary"
                    attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('isolated_blanket_order_id', '!=', False)]}"
                />
            </xpath>
            <field name="sale_order_template_id" position="after">
                <field
                    name="isolated_blanket_order_id"
                    attrs="{'invisible': [('isolated_blanket_order_id', '=', False)]}"
                />
            </field>

        </field>
    </record>

</odoo>
