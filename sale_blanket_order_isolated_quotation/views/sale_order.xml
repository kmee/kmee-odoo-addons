<odoo>

    <record model="ir.ui.view" id="sale_isolated_quotation.view_order_form">
        <field name="active">False</field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.blanket.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="sale_order_template_id" position="before">
                <field name="blanket_order_type" widget="radio" />
                <field
                    name="blanket_order_id"
                    attrs="{'invisible': [('blanket_order_type', '=', 'none')],
                              'required': [('blanket_order_type', '!=', 'none')]}"
                />
            </field>

            <xpath
                expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']"
                position="before"
            >
                <field name="blanket_order_line_id" invisible="1" />
                <field
                    name="original_bo_qty"
                    attrs="{'column_invisible': [('parent.blanket_order_type', '=', 'none')]}"
                />
                <field
                    name="available_bo_qty"
                    attrs="{'column_invisible': [('parent.blanket_order_type', '=', 'none')]}"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_uom_qty']"
                position="before"
            >
                <field name="blanket_order_line_id" invisible="1" />
                <field
                    name="original_bo_qty"
                    attrs="{'invisible': [('parent.blanket_order_type', '=', 'none')]}"
                />
                <field
                    name="available_bo_qty"
                    attrs="{'invisible': [('parent.blanket_order_type', '=', 'none')]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
