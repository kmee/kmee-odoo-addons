<odoo>

    <record model="ir.ui.view" id="sale_blanket_order_form_view">
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="arch" type="xml">
            <button name="action_cancel" position="before">
                <button
                    name="action_create_reference_quotation"
                    string="Create Blanket Order"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('state', 'not in', ['open'])]}"
                />
                <button
                    name="action_create_increment_quotation"
                    string="Increment"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('state', 'not in', ['open'])]}"
                />
            </button>
            <field name="validity_date" position="after">
                <field name="isolated_quotation_id" />
            </field>
            <xpath
                expr="//button[@name='%(sale_blanket_order.action_create_sale_order)d']"
                position="attributes"
            >
                <attribute name="attrs">{'invisible': 1}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
