<odoo>

    <record model="ir.ui.view" id="hr_attendance_overtime_payment_wizard_form_view">
        <field name="model">hr_attendance.overtime.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Hr_attendance Overtime Payment Wizard">
                <group>
                    <group>
                        <field name="employee_id" />
                        <field name="date" />
                        <field name="total_overtime" />
                    </group>
                    <group>
                        <field name="payment_total" />
                        <field name="note" />
                    </group>
                </group>
                <footer>
                    <button name="doit" string="OK" class="btn-primary" type="object" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="hr_attendance_overtime_payment_wizard_act_window"
    >
        <field name="name">Overtime Payment Wizard</field>
        <field name="res_model">hr_attendance.overtime.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

 <record
        id="act_action_hr_employee_overtime_payment_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Pay Overtime</field>
        <field name="res_model">hr_attendance.overtime.payment.wizard</field>
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_attendance_overtime_payment_wizard_form_view" />
        <field name="context">{'default_employee_id': active_id}</field>
        <field
            name="groups_id"
            eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"
        />
        <field name="target">new</field>
    </record>


    <record model="ir.ui.menu" id="hr_attendance_overtime_payment_wizard_menu">
        <field name="name">Pagamento de Horas Extras</field>
        <field name="parent_id" ref="hr_overtime_menu" />
        <field name="action" ref="hr_attendance_overtime_payment_wizard_act_window" />
        <field name="sequence" eval="999" />
    </record>
</odoo>
