    <record model="ir.ui.view" id="hr_overtime_multiplier_range_search_view">
        <field name="model">hr.overtime.multiplier.range</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="overtime_from" />
                <field name="overtime_to" />
                <field name="multiplier" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_overtime_multiplier_range_tree_view">
        <field name="model">hr.overtime.multiplier.range</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name" />
                <field name="monday" />
                <field name="tuesday" />
                <field name="wednesday" />
                <field name="thursday" />
                <field name="friday" />
                <field name="saturday" />
                <field name="sunday" />
                <field name="holiday" />
                <field name="overtime_from" />
                <field name="overtime_to" />
                <field
                    name="multiplier"
                    widget="float_time"
                    modifiers="{&quot;required&quot;: true}"
                />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="hr_overtime_multiplier_range_act_window">
        <field name="name">Multiplier Range</field>
        <field name="res_model">hr.overtime.multiplier.range</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="hr_overtime_multiplier_range_menu"
        name="Overtime Multiplier Range"
        parent="hr_attendance_overtime_config"
        action="hr_overtime_multiplier_range_act_window"
        sequence="17"
    />

</odoo>
