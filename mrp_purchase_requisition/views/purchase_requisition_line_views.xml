<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_requisition_line_list" model="ir.ui.view">
        <field name="name">purchase.requisition.line.list</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="requisition_id" />
                <field name="production_id" />
                <field name="product_id" />
                <field name="default_code" optional="show" />
                <field name="product_qty" />
                <field name="qty_ordered" />
                <field name="product_uom_id" groups="uom.group_uom" />
                <field name="schedule_date" />
                <field name="production_date_finished" optional="hide" />
                <field name="justificativa" optional="hide" />
            </list>
        </field>
    </record>
    <record id="action_requisition_lines" model="ir.actions.act_window">
        <field name="name">Purchase Agreement Lines</field>
        <field name="res_model">purchase.requisition.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="purchase_requisition_line_list" />
    </record>
    <menuitem
        id="menu_requisition_lines"
        name="Purchase Agreement Lines"
        parent="purchase.menu_procurement_management"
        action="action_requisition_lines"
        sequence="14"
    />
</odoo>
