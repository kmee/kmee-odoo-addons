<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field name="name">purchase.requisition.form.mrp.purchase.requisition</field>
        <field name="model">purchase.requisition</field>
        <field
            name="inherit_id"
            ref="purchase_requisition.view_purchase_requisition_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="production_origins" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='price_unit']"
                position="before"
            >
                <field name="production_id" />
                <field name="production_date_finished" optional="hide" />
                <field name="schedule_date" optional="hide" />
                <field name="manufacturer_pref" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='line_ids']/form" position="inside">
                <group name="justification">
                    <field name="justificativa" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
