<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.quote.summary</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="after">
                <block title="Chatter Quote Summary" id="quote_summary">
                    <setting
                        id="quote_summary_enabled_setting"
                        help="Show only the most recent reply in chatter messages; the quoted history is loaded on demand."
                    >
                        <field name="quote_summary_enabled" />
                    </setting>
                    <setting
                        id="quote_summary_models_setting"
                        help="Comma-separated technical model names (e.g. helpdesk.ticket,crm.lead). Empty applies to every chatter."
                    >
                        <field name="quote_summary_models" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
