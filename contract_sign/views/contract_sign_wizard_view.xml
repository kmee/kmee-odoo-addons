<odoo>
  <record id="view_contract_sign_wizard_form" model="ir.ui.view">
    <field name="name">contract.sign.wizard.form</field>
    <field name="model">contract.sign.wizard</field>
    <field name="arch" type="xml">
      <form string="Send to Sign">
        <group>
          <field name="contract_id" />
          <field name="template_id" />
          <field name="partner_id" />
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Confirm Send" />
          <button string="Cancel" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_contract_sign_wizard" model="ir.actions.act_window">
    <field name="name">Send to Sign</field>
    <field name="res_model">contract.sign.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_contract_sign_wizard_form" />
    <field name="target">new</field>
    <field name="context">{'default_contract_id': active_id}</field>
  </record>
</odoo>
