<odoo>

  <record id="action_contract_sign_request_filtered" model="ir.actions.act_window">
    <field name="name">Contract Signs</field>
    <field name="res_model">sign.request</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('contract_id', '=', active_id)]</field>
    <field name="context">{}</field>
  </record>

  <record id="view_contract_form_inherit_sign" model="ir.ui.view">
    <field name="name">contract.contract.form.sign</field>
    <field name="model">contract.contract</field>
    <field name="inherit_id" ref="contract.contract_contract_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button
                    name="%(action_contract_sign_wizard)d"
                    type="action"
                    string="Send to Sign"
                    context="{'active_id': id}"
                    class="oe_highlight"
                    attrs="{'invisible': [('sign_request_id','!=',False)]}"
                />
      </xpath>

      <xpath expr="//sheet" position="inside">
        <group>
          <field name="sign_status" />
          <field name="sign_request_id" invisible="1" />
        </group>
      </xpath>

      <xpath expr="//sheet" position="after">
        <div class="oe_button_box" name="button_box" />
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
        <button
                    name="%(action_contract_sign_request_filtered)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-pencil"
                    attrs="{'invisible': [('sign_request_id', '=', False)]}"
                >
          <field name="sign_request_id" widget="statinfo" string="Digital Sign" />
        </button>
      </xpath>
    </field>
  </record>

</odoo>
