<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_purchase_report_zitron" model="ir.ui.view">
        <field name="name">res.company.form.purchase.report.zitron</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Purchase Report" name="purchase_report_zitron">
                    <group>
                        <field
                            name="purchase_report_footer_note"
                            colspan="2"
                            widget="html"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
