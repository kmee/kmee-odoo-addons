<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edit_project_zitron_project_number" model="ir.ui.view">
        <field name="name">project.project.form.zitron.project.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="zitron_project_number" />
            </xpath>
        </field>
    </record>

    <record id="view_project_project_filter_zitron_project_number" model="ir.ui.view">
        <field name="name">project.project.search.zitron.project.number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="zitron_project_number" />
            </xpath>
        </field>
    </record>
</odoo>
