<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Second print action: same document templates, A4 portrait. The
         o_zitron_portrait class (set from this wrapper) switches the CSS
         of purchase_order_cabecalho.xml / purchase_order_linhas.xml to
         smaller fonts and paddings. -->
    <template id="report_purchaseorder_portrait">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="zitron_portrait" t-value="True" />
                <t
                    t-call="purchase.report_purchaseorder_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_purchase_order_portrait" model="ir.actions.report">
        <field name="name">Purchase Order (Portrait)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >purchase_report_zitron.report_purchaseorder_portrait</field>
        <field
            name="report_file"
        >purchase_report_zitron.report_purchaseorder_portrait</field>
        <field name="print_report_name">
            (object.state in ('draft', 'sent') and 'Request for Quotation - %s' % (object.name) or
            'Purchase Order - %s' % (object.name))</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
        <field
            name="paperformat_id"
            ref="purchase_report_zitron.paperformat_purchase_order_portrait"
        />
    </record>

    <!-- Request for Quotation prints: same document template as the purchase
         order (it already titles draft orders "Request for Quotation"), so the
         stock quotation layout is no longer used. The core action
         (purchase.report_purchase_quotation, also used by the "send by
         e-mail" attachment) is pointed to a landscape wrapper; a portrait
         action mirrors the purchase order one. Each wrapper has its own
         report name so the actions never share a template. -->
    <template id="report_purchasequotation_zitron">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="purchase.report_purchaseorder_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <template id="report_purchasequotation_zitron_portrait">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="zitron_portrait" t-value="True" />
                <t
                    t-call="purchase.report_purchaseorder_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field
            name="report_name"
        >purchase_report_zitron.report_purchasequotation_zitron</field>
        <field
            name="report_file"
        >purchase_report_zitron.report_purchasequotation_zitron</field>
        <field
            name="paperformat_id"
            ref="purchase_report_zitron.paperformat_purchase_order_landscape"
        />
    </record>

    <record id="action_report_purchase_quotation_portrait" model="ir.actions.report">
        <field name="name">Request for Quotation (Portrait)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >purchase_report_zitron.report_purchasequotation_zitron_portrait</field>
        <field
            name="report_file"
        >purchase_report_zitron.report_purchasequotation_zitron_portrait</field>
        <field
            name="print_report_name"
        >'Request for Quotation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
        <field
            name="paperformat_id"
            ref="purchase_report_zitron.paperformat_purchase_order_portrait"
        />
    </record>
</odoo>
