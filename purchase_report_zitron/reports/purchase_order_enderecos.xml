<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Billing address block: the company address is where the vendor
         must send the invoice. Delivery address is printed by the core
         "Shipping address" block (purchase / purchase_stock). -->
    <template
        id="report_purchaseorder_document_enderecos"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//div[hasclass('page')]/div[hasclass('oe_structure')]" position="after">
            <div class="row mb-2" name="billing_address_block">
                <div class="col-6">
                    <strong>Endereço de faturamento:</strong>
                    <div
                        t-field="o.company_id.partner_id"
                        t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True, "phone_icons": True}'
                    />
                </div>
            </div>
        </xpath>
    </template>
</odoo>
