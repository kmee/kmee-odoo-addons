<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Purchase Order PDF, line table (group "linhas"):
        - cost center per line and taxes in columns (IPI, ICMS, PIS, COFINS: % over value in one cell, to fit landscape A4);
        - delivery date per line in place of the Discount column;
        - quantity without decimals when integer;
        - table font 9pt;
        - note about tax inclusion in the unit price.
        The line number column comes from purchase_order_line_sequence
        (td_line_number / th_line_number) and is not touched here.
    -->
    <template
        id="report_purchaseorder_document_linhas"
        inherit_id="purchase.report_purchaseorder_document"
        priority="99"
    >
        <!-- Font size of the table (9pt) -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class" add="o_zitron_lines" separator=" " />
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <style>
                table.o_zitron_lines { font-size: 9pt; }
                table.o_zitron_lines th,
                table.o_zitron_lines td { padding: 2px 4px; }
                table.o_zitron_lines td.o_zitron_num { white-space: nowrap; }
            </style>
        </xpath>

        <!-- Header: Discount becomes delivery date; Taxes becomes cost center + 4 tax columns (percent over amount) -->
        <xpath expr="//th[@name='th_discount']" position="replace">
            <th name="th_date_planned" class="text-center">
                <strong>Delivery</strong>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_cost_center"><strong>Cost Center</strong></th>
            <th name="th_ipi" class="text-end"><strong>IPI</strong></th>
            <th name="th_icms" class="text-end"><strong>ICMS</strong></th>
            <th name="th_pis" class="text-end"><strong>PIS</strong></th>
            <th name="th_cofins" class="text-end"><strong>COFINS</strong></th>
        </xpath>

        <!-- Quantity: no decimals when the value is an integer -->
        <xpath
            expr="//td[span[@t-field='line.product_qty']]/span[@t-field='line.product_qty']"
            position="replace"
        >
            <span
                t-if="abs(line.product_qty - round(line.product_qty)) &lt; 0.000001"
                t-field="line.product_qty"
                t-options="{'precision': 0}"
            />
            <span
                t-else=""
                t-field="line.product_qty"
                t-options="{'min_precision': 1}"
            />
        </xpath>
        <xpath
            expr="//td[span[@t-field='line.product_qty']]"
            position="attributes"
        >
            <attribute name="class">text-end o_zitron_num</attribute>
        </xpath>

        <!-- Body: Discount cell becomes delivery date per line -->
        <xpath
            expr="//td[span/span[@t-field='line.discount']]"
            position="replace"
        >
            <td name="td_date_planned" class="text-center o_zitron_num">
                <span
                    t-field="line.date_planned"
                    t-options="{'date_only': 'true'}"
                />
            </td>
        </xpath>

        <!-- Body: Taxes cell becomes cost center + 4 cells (fields of l10n_br_fiscal.document.line.mixin).
             Currency of the fiscal amounts: the mixin declares currency_id as
             the company currency, but on purchase.order.line the core field
             (related to the order currency) wins, and the fiscal engine
             computes the amounts from price_unit with no conversion. So the
             stored amounts are in the order currency (checked on a EUR order:
             ICMS is derived from the EUR price) and line.currency_id, the
             currency_field of these Monetary fields, is the right label. -->
        <xpath
            expr="//td[span[contains(@t-out, 'line.taxes_id')]]"
            position="replace"
        >
            <td name="td_cost_center">
                <span t-out="line._zitron_report_cost_center()" />
            </td>
            <td name="td_ipi" class="text-end o_zitron_num">
                <div><span t-field="line.ipi_percent" t-options="{'precision': 2}" />%</div>
                <div>
                    <span
                        t-field="line.ipi_value"
                        t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                    />
                </div>
            </td>
            <td name="td_icms" class="text-end o_zitron_num">
                <div><span t-field="line.icms_percent" t-options="{'precision': 2}" />%</div>
                <div>
                    <span
                        t-field="line.icms_value"
                        t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                    />
                </div>
            </td>
            <td name="td_pis" class="text-end o_zitron_num">
                <div><span t-field="line.pis_percent" t-options="{'precision': 2}" />%</div>
                <div>
                    <span
                        t-field="line.pis_value"
                        t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                    />
                </div>
            </td>
            <td name="td_cofins" class="text-end o_zitron_num">
                <div><span t-field="line.cofins_percent" t-options="{'precision': 2}" />%</div>
                <div>
                    <span
                        t-field="line.cofins_value"
                        t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"
                    />
                </div>
            </td>
        </xpath>

        <!-- Expected Arrival (order level, earliest line date) is replaced by the per-line date -->
        <xpath expr="//div[@id='informations']/div[@t-if='o.date_planned']" position="replace" />

        <!-- TO CONFIRM with the client (Nathalia, 30/10): exact wording of the note -->
        <xpath expr="//div[@id='total']" position="before">
            <p class="small text-muted mb-1 o_zitron_price_note">
                Unit price includes ICMS, PIS and COFINS; IPI is shown separately.
            </p>
        </xpath>
    </template>
</odoo>
