<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Landscape A4 for the Purchase Order PDF (tax columns need the width) -->
    <record id="paperformat_purchase_order_landscape" model="report.paperformat">
        <field name="name">A4 Landscape (Purchase Order)</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">42</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">37</field>
        <field name="dpi">90</field>
    </record>

    <!-- Only the Purchase Order action; the RFQ action stays portrait -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field
            name="paperformat_id"
            ref="purchase_report_zitron.paperformat_purchase_order_landscape"
        />
    </record>
</odoo>
