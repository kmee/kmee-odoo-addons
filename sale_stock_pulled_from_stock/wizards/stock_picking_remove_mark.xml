<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_remove_mark" model="ir.ui.view">
        <field name="name">Stock Picking Remove Mark</field>
        <field name="model">stock.picking.remove_mark</field>
        <field name="arch" type="xml">
            <form string='Remove the "Pulled From Stock" Mark'>
                <field name="picking_id" invisible="1" />
                <footer>
                    <button
                        name="button_remove_mark"
                        type="object"
                        string="Remove Mark"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="act_stock_picking_remove_mark" model="ir.actions.act_window">
        <field name="name">Remove the "Pulled From Stock" Mark</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking.remove_mark</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
