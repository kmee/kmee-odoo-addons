<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="demo_product" model="product.product">
        <field name="name">Fita adesiva industrial 48 mm</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True" />
        <field name="list_price">18.0</field>
        <field name="standard_price">9.5</field>
    </record>

    <!-- Local interno do armazém fora do estoque: não entra em "No estoque" -->
    <record id="demo_location_dock" model="stock.location">
        <field name="name">Doca de expedição</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_company" />
    </record>

    <!-- Subnível do estoque: entra em "No estoque" -->
    <record id="demo_location_shelf" model="stock.location">
        <field name="name">Prateleira A</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock" />
    </record>

    <record id="demo_quant_stock" model="stock.quant">
        <field name="product_id" ref="demo_product" />
        <field name="location_id" ref="stock.stock_location_stock" />
        <field name="inventory_quantity">120</field>
    </record>
    <record id="demo_quant_shelf" model="stock.quant">
        <field name="product_id" ref="demo_product" />
        <field name="location_id" ref="demo_location_shelf" />
        <field name="inventory_quantity">30</field>
    </record>
    <record id="demo_quant_dock" model="stock.quant">
        <field name="product_id" ref="demo_product" />
        <field name="location_id" ref="demo_location_dock" />
        <field name="inventory_quantity">45</field>
    </record>
    <function model="stock.quant" name="action_apply_inventory">
        <value
            eval="[ref('demo_quant_stock'), ref('demo_quant_shelf'), ref('demo_quant_dock')]"
        />
    </function>
</odoo>
