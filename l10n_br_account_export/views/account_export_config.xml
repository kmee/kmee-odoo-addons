<odoo>

    <record id="account_export_config_form" model="ir.ui.view">
        <field name="name">l10n_br.account.export.config.form</field>
        <field name="model">l10n_br.account.export.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field
                                name="name"
                                placeholder="Escritorio Contabil X"
                            /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="layout" />
                            <field name="encoding" />
                        </group>
                        <group>
                            <field name="mapping_plan_id" />
                            <field name="company_code" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_export_config_tree" model="ir.ui.view">
        <field name="name">l10n_br.account.export.config.tree</field>
        <field name="model">l10n_br.account.export.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="layout" />
                <field name="encoding" />
            </tree>
        </field>
    </record>

    <record id="account_export_config_action" model="ir.actions.act_window">
        <field name="name">Configuracoes de Exportacao</field>
        <field name="res_model">l10n_br.account.export.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
