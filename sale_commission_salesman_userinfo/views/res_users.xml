<odoo>

    <record model="ir.ui.view" id="res_users_form_view">
        <field name="name">res.users.form (in sale_commission_salesman_userinfo)</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <page name="references" position="before">
                <page name="team_agents" string="Agent">
                    <group>
                        <group>
                            <field name="agent" />
                            <field name="agent_type" />
                            <field name="commission_id" />
                            <field name="settlement" />
                            <field name="salesman_as_agent" />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
