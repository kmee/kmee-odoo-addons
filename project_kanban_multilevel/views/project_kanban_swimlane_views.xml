<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kanban_swimlane_form" model="ir.ui.view">
        <field name="name">project.kanban.swimlane.form</field>
        <field name="model">project.kanban.swimlane</field>
        <field name="arch" type="xml">
            <form string="Swimlane">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="sequence"/>
                            <field name="is_expedite"/>
                        </group>
                        <group>
                            <field name="color" widget="color"/>
                            <field name="icon"/>
                            <field name="wip_limit"/>
                            <field name="fold"/>
                            <field name="task_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kanban_swimlane_list" model="ir.ui.view">
        <field name="name">project.kanban.swimlane.list</field>
        <field name="model">project.kanban.swimlane</field>
        <field name="arch" type="xml">
            <list string="Swimlanes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="is_expedite"/>
                <field name="wip_limit"/>
                <field name="task_count"/>
            </list>
        </field>
    </record>

    <record id="action_kanban_swimlane" model="ir.actions.act_window">
        <field name="name">Swimlanes</field>
        <field name="res_model">project.kanban.swimlane</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
