<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_swimlane_template_wizard_form" model="ir.ui.view">
        <field name="name">project.kanban.swimlane.wizard.form</field>
        <field name="model">project.kanban.swimlane.wizard</field>
        <field name="arch" type="xml">
            <form string="Criar Swimlanes a partir de Template">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="template" widget="radio"/>
                </group>
                <footer>
                    <button name="action_apply" string="Aplicar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
