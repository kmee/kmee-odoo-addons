<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_copy_swimlanes_wizard_form" model="ir.ui.view">
        <field name="name">project.kanban.copy.swimlanes.wizard.form</field>
        <field name="model">project.kanban.copy.swimlanes.wizard</field>
        <field name="arch" type="xml">
            <form string="Copiar Swimlanes de Outro Projeto">
                <group>
                    <field name="target_project_id" readonly="1"/>
                    <field name="source_project_id"/>
                </group>
                <footer>
                    <button name="action_copy" string="Copiar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
