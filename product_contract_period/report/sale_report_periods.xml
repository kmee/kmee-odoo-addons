<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document_inherit_periods" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[contains(@class, 'o_main_table')]" position="after">
      <t t-if="o.contract_period_details">
        <div class="mt16">
            <p><strong>Detalhes de Períodos</strong></p>
            <pre style="white-space: pre-wrap; font-family: inherit; font-size: 12px;"
               t-esc="o.contract_period_details"/>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
