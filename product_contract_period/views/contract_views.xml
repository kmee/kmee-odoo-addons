<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Adicionar campos de período na visualização da linha de contrato -->
    <record id="contract_line_form_inherit_period" model="ir.ui.view">
        <field name="name">contract.line.form.inherit.period</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="period_qty" />
                <field name="period_count" />
            </xpath>
        </field>
    </record>


    <!-- Adicionar campos de período à visualização de árvore da linha de contrato -->
    <record id="contract_line_tree_inherit_period" model="ir.ui.view">
        <field name="name">contract.line.tree.inherit.period</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="period_qty" />
                <field name="period_count" />
            </xpath>
        </field>
    </record>

