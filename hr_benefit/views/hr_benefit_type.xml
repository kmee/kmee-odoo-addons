<odoo>
    <data>
        <record id="action_hr_benefit_type" model="ir.actions.act_window">
            <field name="name">Tipos de benefício</field>
            <field name="res_model">hr.benefit.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_hr_benefit"
            name="Benefícios"
            parent="hr.menu_human_resources_configuration"
            sequence="20"
            groups="hr.group_hr_manager"
        />

            <menuitem
            id="menu_hr_benefit_type"
            name="Tipos de benefício"
            parent="menu_hr_benefit"
            sequence="20"
            action="action_hr_benefit_type"
            groups="hr.group_hr_manager"
        />

        </data>

        <record id="hr_benefit_view_tree" model="ir.ui.view">
            <field name="name">hr.benefit.view.tree</field>
            <field name="model">hr.benefit.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="max_dependents" />
                    <field name="dependent_payment_value" />
                    <field name="company_percentage" />
                    <field name="employee_percentage" />
                    <field name="benefit_fixed_value" />
                </tree>
            </field>
        </record>
</odoo>
