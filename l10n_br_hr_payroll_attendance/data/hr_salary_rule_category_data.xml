         caso do intervalo intrajornada suprimido depois da Lei 13.467/2017
         (art. 71, § 4º da CLT). -->
    <record id="hr_salary_rule_category_ind" model="hr.salary.rule.category">
        <field name="name">Verba Indenizatória</field>
        <field name="code">IND</field>
    </record>

</odoo>
