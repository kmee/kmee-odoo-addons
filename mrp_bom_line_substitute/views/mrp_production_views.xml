<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.substitute</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field
                    name="substitute_product_ids"
                    widget="many2many_tags"
                    readonly="1"
                    optional="show"
                />
                <field name="is_substitute" column_invisible="True" />
                <field name="has_been_replaced" column_invisible="True" />
            </xpath>
        </field>
    </record>
</odoo>
