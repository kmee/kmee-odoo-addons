        <field name="code">ATESTADO_MED</field>
        <field name="l10n_br_category">disease</field>
        <field name="l10n_br_need_attachment" eval="True" />
        <field name="l10n_br_payroll_discount" eval="False" />
        <field name="l10n_br_discount_dsr" eval="False" />
        <field name="l10n_br_days_limit">15</field>
        <field name="leave_validation_type">hr</field>
        <field name="requires_allocation">no</field>
    </record>

