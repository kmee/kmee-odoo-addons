<odoo noupdate="1">
    <record id="account_journal_allowed_groups_rule" model="ir.rule">
        <field name="name">Journal: allowed groups</field>
        <field name="model_id" ref="account.model_account_journal" />
        <field name="domain_force">
            ['|', ('allowed_group_ids', '=', False),
            ('allowed_group_ids', 'in', user.groups_id.ids)]
        </field>
    </record>
    <record id="account_move_allowed_groups_rule" model="ir.rule">
        <field name="name">Journal Entry: allowed groups of the journal</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="domain_force">
            [('journal_id', 'any', ['|', ('allowed_group_ids', '=', False),
            ('allowed_group_ids', 'in', user.groups_id.ids)])]
        </field>
    </record>
    <record id="account_move_line_allowed_groups_rule" model="ir.rule">
        <field name="name">Journal Item: allowed groups of the journal</field>
        <field name="model_id" ref="account.model_account_move_line" />
        <field name="domain_force">
            [('journal_id', 'any', ['|', ('allowed_group_ids', '=', False),
            ('allowed_group_ids', 'in', user.groups_id.ids)])]
        </field>
    </record>
    <record id="account_payment_allowed_groups_rule" model="ir.rule">
        <field name="name">Payment: allowed groups of the journal</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="domain_force">
            [('journal_id', 'any', ['|', ('allowed_group_ids', '=', False),
            ('allowed_group_ids', 'in', user.groups_id.ids)])]
        </field>
    </record>
    <record id="account_invoice_report_allowed_groups_rule" model="ir.rule">
        <field name="name">Invoices Analysis: allowed groups of the journal</field>
        <field name="model_id" ref="account.model_account_invoice_report" />
        <field name="domain_force">
            [('journal_id', 'any', ['|', ('allowed_group_ids', '=', False),
            ('allowed_group_ids', 'in', user.groups_id.ids)])]
        </field>
    </record>
</odoo>
