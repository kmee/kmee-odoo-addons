<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data>
    <template
            id="mail_notification_layout_configurable_buttons"
            inherit_id="mail.mail_notification_layout"
        >
      <xpath
                expr="//td[@t-if='has_button_access'][a[@t-att-href]]"
                position="attributes"
            >
        <attribute
                    name="t-if"
                >has_button_access and 'Sale' not in button_access['title']</attribute>
      </xpath>
</template>
</data>
</odoo>
