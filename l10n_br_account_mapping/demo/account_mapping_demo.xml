<odoo>

    <record id="plan_escritorio_demo" model="l10n_br_account_mapping.plan">
        <field name="name">Plano do Escritorio (demo)</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="mapping_receita_demo" model="l10n_br_account_mapping.account">
        <field name="plan_id" ref="plan_escritorio_demo" />
        <field name="code">31101</field>
        <field name="name">Receita de vendas</field>
    </record>

    <record id="mapping_despesa_demo" model="l10n_br_account_mapping.account">
        <field name="plan_id" ref="plan_escritorio_demo" />
        <field name="code">41101</field>
        <field name="name">Despesas operacionais</field>
    </record>

</odoo>
