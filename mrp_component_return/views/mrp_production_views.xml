<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view_component_return" model="ir.ui.view">
        <field name="name">mrp.production.form.component.return</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="before">
                <field name="has_pending_component_return" invisible="1" />
                <button
                    name="button_force_return_all"
                    type="object"
                    string="Return All"
                    invisible="not has_pending_component_return or state == 'cancel'"
                    groups="mrp.group_mrp_user"
                    confirm="All the components left in pre-production will be returned to stock. Continue?"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not has_pending_component_return or state == 'cancel'"
                >
                    There are components picked for this order that were not
                    consumed. Return them to stock with the <strong
                >Return All</strong> button.
                </div>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_pending_return_view_list" model="ir.ui.view">
        <field name="name">mrp.production.pending.return.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list string="Pending Reservations" create="0" edit="0">
                <field name="name" />
                <field name="date_start" optional="show" />
                <field name="product_id" />
                <field name="product_qty" />
                <field name="product_uom_id" groups="uom.group_uom" />
                <field name="state" widget="badge" />
                <button
                    name="action_resolve_component_return"
                    type="object"
                    string="Resolve Reservations"
                    icon="fa-undo"
                />
            </list>
        </field>
    </record>

    <record id="mrp_production_pending_return_action" model="ir.actions.act_window">
        <field name="name">MOs: Pending Reservations</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('has_pending_component_return', '=', True)]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('mrp_production_pending_return_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('mrp.mrp_production_form_view')})]"
        />
    </record>

    <menuitem
        id="menu_mrp_production_pending_return"
        action="mrp_production_pending_return_action"
        parent="mrp.menu_mrp_reporting"
        groups="mrp.group_mrp_user"
        sequence="90"
    />
</odoo>
