#. module: project_tech_lead
#: model:ir.module.module,description:base.module_project_tech_lead
msgid ""
"=================\n"
"Project Tech Lead\n"
"=================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
"   !! changes will be overwritten.                   !!\n"
