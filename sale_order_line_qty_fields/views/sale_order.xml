<odoo>

    <record model="ir.ui.view" id="sale_order_line_form_view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//div[@name='ordered_qty']"
                position="after"
            >
                <field
                    name="qty_available_today"
                    groups="sale_order_line_qty_fields.group_qty_available_today"
                />
                <field
                    name="free_qty_today"
                    groups="sale_order_line_qty_fields.group_free_qty_today"
                />
                <field
                    name="free_qty"
                    groups="sale_order_line_qty_fields.group_free_qty"
                />
            </xpath>
        </field>
    </record>
</odoo>
