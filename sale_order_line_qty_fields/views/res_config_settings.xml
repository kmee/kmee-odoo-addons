<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.qty.fields.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='connectors_setting_container']" position="after">
                <h2 class="mt32">Quantity Fields</h2>
                <div
                    class="row mt16 o_settings_container"
                    id="quantity_fields_setting_container"
                >
                    <div class="col-12 col-lg-6 o_setting_box" id="qty_available_today">
                        <div class="o_setting_left_pane">
                            <field name="group_qty_available_today" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_qty_available_today" />
                            <div class="text-muted">
                                Quantity available in stock today.
                            </div>
                        </div>
                    </div>
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="group_free_qty_today"
                    >
                        <div class="o_setting_left_pane">
                            <field name="group_free_qty_today" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_free_qty_today" />
                            <div class="text-muted">
                                Quantity available in stock today, considering reserves.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="group_free_qty">
                        <div class="o_setting_left_pane">
                            <field name="group_free_qty" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_free_qty" />
                            <div class="text-muted">
                                Total quantity available for sale, without considering reserves or future commitments.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
