<odoo>
    <record id="purchase_rfq_round_import_view_form" model="ir.ui.view">
        <field name="name">purchase.rfq.round.import.form</field>
        <field name="model">purchase.rfq.round.import</field>
        <field name="arch" type="xml">
            <form string="Import Responses">
                <field name="state" invisible="1" />
                <field name="round_id" invisible="1" />
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="state != 'upload'"
                >
                    Use the spreadsheet sent with the quotation (with the ID column), or the
                    vendor's own spreadsheet: in that case choose the quotation and check the
                    detected columns.
                </div>
                <group>
                    <field
                        name="file"
                        filename="file_name"
                        readonly="state != 'upload'"
                    />
                    <field name="file_name" invisible="1" />
                    <field name="order_id" />
                    <field name="header_row" invisible="state != 'mapping'" />
                </group>
                <field name="column_ids" invisible="state != 'mapping'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="label" />
                        <field name="column" />
                    </list>
                </field>
                <field name="result" invisible="not result" widget="text" nolabel="1" />
                <footer>
                    <button
                        name="action_analyze"
                        type="object"
                        string="Analyze"
                        class="btn-primary"
                        invisible="state != 'upload'"
                    />
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        invisible="state != 'mapping' or result"
                    />
                    <button special="cancel" string="Close" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
