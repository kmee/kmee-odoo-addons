<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <template
        id="job_detail_custom"
        inherit_id="website_hr_recruitment.detail"
        name="Job Detail Customization"
        priority="999"
    >
        <xpath
            expr="//a[@role='button' and contains(@class, 'btn-primary')]"
            position="replace"
        >
            <a
                t-if="job.is_published"
                role="button"
                t-attf-href="/jobs/apply/#{job.id}"
                class="btn btn-primary btn-lg"
            >Apply Now!</a>
            <a
                t-if="not job.is_published"
                role="button"
                t-attf-href="/jobs/apply/#{job.id}?access_token=#{access_token}"
                class="btn btn-primary btn-lg"
            >Apply Now!</a>
        </xpath>
    </template>
</odoo>
