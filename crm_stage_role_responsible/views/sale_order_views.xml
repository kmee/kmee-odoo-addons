<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_role" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.role</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="bdr_id" widget="many2one_avatar_user" />
                <field name="sdr_id" widget="many2one_avatar_user" />
                <field name="hunter_id" widget="many2one_avatar_user" />
                <field name="closer_id" widget="many2one_avatar_user" />
                <field name="farmer_id" widget="many2one_avatar_user" />
            </field>
        </field>
    </record>
</odoo>
