#. module: sac
#: model:mail.template,body_html:sac.mail_template_sac_troca_realizada
msgid ""
"\n"
"<p>Olá ${object.customer_name or ''},</p>\n"
"<br />\n"
"<p>A troca do seu produto foi enviada.</p>\n"
"<br/></br>\n"
"<p>Seu código de rastreamento é o : ${object.tracking_code or ''}<br/></p>\n"
"<p>Veja todos os detalhes da postagem no link abaixo inserindo o código acima.\n"
"https://www2.correios.com.br/sistemas/rastreamento/\n"
"<br/>\n"
"<p>Se você ainda tiver alguma dúvida, não exite em entrar em contato.</p>\n"
"<br />\n"
"<p>Muito obrigado.</p>"
msgstr ""

#. module: sac
#: model:mail.template,body_html:sac.mail_template_sac_complete
msgid ""
"\n"
"<p>Olá ${object.customer_name or ''},</p>\n"
"<br />\n"
"<p>O chamado nº ${object.name} foi considerado concluido.</p>\n"
"<br/>\n"
"<p>Agradeçemos o contato. Sua opinião é muito importante para melhorarmos nossos produtos.<br/></p>\n"
"<br/>\n"
"<p>Se você ainda tiver alguma dúvida, por favor entre em contato.</p>\n"
"<br/>\n"
"<p>Atenciosamente.</p>"
msgstr ""

