<odoo>
    <record id="purchase_rfq_round_view_form" model="ir.ui.view">
        <field name="name">purchase.rfq.round.form - purchase_rfq_comparison</field>
        <field name="model">purchase.rfq.round</field>
        <field
            name="inherit_id"
            ref="purchase_rfq_round.purchase_rfq_round_view_form"
        />
        <field name="arch" type="xml">
            <page name="vendors" position="after">
                <page string="Criteria" name="criteria">
                    <group>
                        <group string="Price">
                            <field name="price_basis" />
                            <field
                                name="pv_monthly_rate"
                                invisible="price_basis != 'present_value'"
                            />
                            <field name="require_approved" />
                        </group>
                        <group string="Weights">
                            <field name="weight_price" />
                            <field name="weight_delay" />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="purchase_rfq_round_quote_view_list" model="ir.ui.view">
        <field name="name">purchase.order.line.rfq.round.quote.list - comparison</field>
        <field name="model">purchase.order.line</field>
        <field
            name="inherit_id"
            ref="purchase_rfq_round.purchase_rfq_round_quote_view_list"
        />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-danger">
                    not rfq_eligible and price_unit != 0
                </attribute>
            </list>
            <field name="date_planned" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="date_planned" position="after">
                <field name="rfq_lead_days" optional="show" />
                <field name="rfq_payment_term_id" optional="show" />
                <field name="rfq_payment_days" optional="hide" />
                <field name="rfq_present_value" optional="show" />
                <field name="rfq_validity_date" optional="show" />
                <field name="rfq_min_qty" optional="hide" />
                <field name="rfq_min_qty_ok" optional="hide" />
                <field name="rfq_vendor_approved" optional="show" />
                <field name="rfq_spec_approved" optional="show" />
                <field name="rfq_eligible" column_invisible="1" />
                <field name="rfq_score" widget="progressbar" optional="show" />
            </field>
        </field>
    </record>

    <record id="purchase_rfq_round_quote_view_pivot" model="ir.ui.view">
        <field
            name="name"
        >purchase.order.line.rfq.round.quote.pivot - comparison</field>
        <field name="model">purchase.order.line</field>
        <field
            name="inherit_id"
            ref="purchase_rfq_round.purchase_rfq_round_quote_view_pivot"
        />
        <field name="arch" type="xml">
            <field name="price_unit" position="after">
                <field name="rfq_score" type="measure" />
                <field name="rfq_present_value" type="measure" />
            </field>
        </field>
    </record>
</odoo>
