<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_br_sst_acidente_company_rule" model="ir.rule">
        <field name="name">Acidente de trabalho: multiempresa</field>
        <field name="model_id" ref="model_l10n_br_sst_acidente" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_br_sst_cat_company_rule" model="ir.rule">
        <field name="name">CAT: multiempresa</field>
        <field name="model_id" ref="model_l10n_br_sst_cat" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
