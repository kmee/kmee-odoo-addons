<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_view_form_sst_cat" model="ir.ui.view">
        <field name="name">hr.employee.form (in l10n_br_hr_sst_cat)</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_l10n_br_sst_acidente"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-ambulance"
                    groups="hr.group_hr_user"
                >
                    <field
                        name="l10n_br_sst_acidente_count"
                        widget="statinfo"
                        string="Acidentes"
                    />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
