<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_sst_cat_view_tree" model="ir.ui.view">
        <field name="name">l10n_br.sst.cat.tree</field>
        <field name="model">l10n_br.sst.cat</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="prazo_situacao == 'atrasada'"
                decoration-warning="prazo_situacao == 'hoje'"
            >
                <field name="employee_id" />
                <field name="tipo_cat_id" />
                <field name="date_emissao" />
                <field name="date_limite" />
                <field name="prazo_situacao" />
                <field name="numero_recibo" optional="show" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="l10n_br_sst_cat_view_form" model="ir.ui.view">
        <field name="name">l10n_br.sst.cat.form</field>
        <field name="model">l10n_br.sst.cat</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_emitir"
                        type="object"
                        string="Emitir"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_cancelar"
                        type="object"
                        string="Cancelar"
                        attrs="{'invisible': [('state', '=', 'cancelled')]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Fora do prazo"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('prazo_situacao', '!=', 'atrasada')]}"
                    />
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="acidente_id" />
                            <field name="employee_id" readonly="1" />
                            <field name="tipo_cat_id" />
                            <field name="cat_origem_id" />
                            <field name="nr_rec_cat_orig" />
                        </group>
                        <group>
                            <field name="date_emissao" />
                            <field name="date_limite" readonly="1" />
                            <field name="prazo_situacao" readonly="1" />
                            <field name="numero_recibo" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="l10n_br_sst_cat_view_search" model="ir.ui.view">
        <field name="name">l10n_br.sst.cat.search</field>
        <field name="model">l10n_br.sst.cat</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="acidente_id" />
                <filter
                    name="filter_atrasada"
                    string="Fora do Prazo"
                    domain="[('prazo_situacao', '=', 'atrasada')]"
                />
                <filter
                    name="filter_pendente"
                    string="Pendentes de Emissão"
                    domain="[('state', '=', 'draft')]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_tipo"
                        string="Tipo de CAT"
                        context="{'group_by': 'tipo_cat_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Situação"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_br_sst_cat_action" model="ir.actions.act_window">
        <field name="name">CATs</field>
        <field name="res_model">l10n_br.sst.cat</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
