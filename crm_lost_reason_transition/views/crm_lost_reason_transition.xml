<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crm_lost_reason_transition_form" model="ir.ui.view">
        <field name="name">crm.lost.reason.transition.form</field>
        <field name="model">crm.lost.reason.transition</field>
        <field name="arch" type="xml">
            <form string="Transition by Reason of Loss">
                <sheet>
                    <group>
                        <field name="lost_reason_id" />
                        <field name="source_stage_id" />
                        <field name="team_id" />
                        <field name="target_stage_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_lost_reason_transition_tree" model="ir.ui.view">
        <field name="name">crm.lost.reason.transition.tree</field>
        <field name="model">crm.lost.reason.transition</field>
        <field name="arch" type="xml">
            <tree string="Loss Reason Transitions">
                <field name="lost_reason_id" />
                <field name="source_stage_id" />
                <field name="team_id" />
                <field name="target_stage_id" />
            </tree>
        </field>
    </record>
</odoo>
