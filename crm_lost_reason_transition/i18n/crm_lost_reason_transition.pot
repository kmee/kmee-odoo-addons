#: model:ir.module.module,description:base.module_crm_lost_reason_transition
msgid ""
"==========================\n"
"CRM Lost Reason Transition\n"
"==========================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
