<odoo>

    <record model="ir.ui.view" id="sale_blanket_order_line_form_view">
        <field name="model">sale.blanket.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='original_uom_qty']" position="after">
                <field name="period_qty" string="Qtd/Per." />
                <field name="period_count" string="N° Per." />
                <field name="recurring_rule_type" string="Tipo" />
                <field name="id" string="ID BL" />
            </xpath>
        </field>
    </record>

</odoo>
