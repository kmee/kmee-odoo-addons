<odoo>

    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="model">sale.order</field>
        <field
            name="inherit_id"
            ref="product_contract_period.view_order_form_inherit_periods"
        />
        <field name="arch" type="xml">
            <field name="period_qty" position="after">
                <field name="use_period_quantity" invisible="1" />
                <field name="blanket_order_line_id" string="ID BL" />
            </field>
            <field name="period_qty" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible':[('use_period_quantity','=', False)]}</attribute>
            </field>
            <field name="period_count" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible':[('use_period_quantity','=', False)]}</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_order_form_view_product_uom_qty">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_uom_qty']"
                position="after"
            >
                <field name="use_period_quantity" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'readonly': [('use_period_quantity', '=', True)], 'required': [('use_period_quantity', '=', False)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
