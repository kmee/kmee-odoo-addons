<odoo>
    <record id="bpmn_import_wizard_view_form" model="ir.ui.view">
        <field name="model">bpmn.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BPMN diagram">
                <field name="state" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="state != 'conflict'"
                >
                    The diagram changed in Odoo and in the file. Choose, for each
                    conflict, which side stays, then import again.
                </div>
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="state != 'invalid'"
                >
                    <field name="problems" />
                </div>
                <group invisible="state != 'draft'">
                    <group>
                        <field name="file" filename="filename" />
                        <field name="filename" invisible="1" />
                        <field name="code" readonly="process_id" />
                        <field name="name" />
                        <field name="process_id" invisible="not process_id" />
                    </group>
                    <group>
                        <field name="note" />
                        <field name="base_version" />
                        <field name="di_prefer" />
                    </group>
                </group>
                <field name="line_ids" invisible="state != 'conflict'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="key" column_invisible="1" />
                        <field name="element" />
                        <field name="prop" />
                        <field name="base_value" />
                        <field name="odoo_value" />
                        <field name="file_value" />
                        <field name="choice" required="1" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="bpmn_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import BPMN diagram</field>
        <field name="res_model">bpmn.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
