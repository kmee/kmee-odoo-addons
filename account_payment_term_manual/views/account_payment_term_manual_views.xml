<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- payment.term.line.manual form view -->
    <record id="view_payment_term_line_manual_form" model="ir.ui.view">
        <field name="name">account.payment.term.line.manual.form</field>
        <field name="model">account.payment.term.line.manual</field>
        <field name="arch" type="xml">
            <form string="Payment Terms">
                <h2>Term Type</h2>
                <group>
                    <group>
                        <field name="value" widget="radio" />
                    </group>

                    <group>
                        <div invisible="value == 'balance'" class="o_row">
                            <label for="value_amount" invisible="value == 'balance'" />
                            <field name="value_amount" class="oe_inline" />
                            <span
                                class="o_form_label oe_inline"
                                invisible="value != 'percent'"
                            >%</span>
                        </div>
                    </group>
                </group>

                <group col="4">
                    <group colspan="2">
                        <h2>Due Date Computation</h2>
                        <field name="months" />
                        <field name="days" />
                        <field name="end_month" />
                        <field name="days_after" invisible="not end_month" />
                    </group>

                    <group colspan="2">
                        <h2>or Fixed Date</h2>
                        <field name="fixed_date" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- payment.term.line.manual list view -->
    <record id="view_payment_term_line_manual_list" model="ir.ui.view">
        <field name="name">account.payment.term.line.manual.list</field>
        <field name="model">account.payment.term.line.manual</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="value" string="Due Type" />
                <field name="value_amount" readonly="value == 'balance'" />
                <field name="months" />
                <field name="days" />
                <field name="end_month" />
                <field name="days_after" invisible="not end_month" />
                <field name="fixed_date" />
            </list>
        </field>
    </record>

    <!-- payment.term.manual search view -->
    <record id="view_payment_term_manual_search" model="ir.ui.view">
        <field name="name">account.payment.term.manual.search</field>
        <field name="model">account.payment.term.manual</field>
        <field name="arch" type="xml">
            <search string="Payment Terms">
                <field name="name" />
                <field name="active" />
            </search>
        </field>
    </record>

    <!-- payment.term.manual form view -->
    <record id="view_payment_term_manual_form" model="ir.ui.view">
        <field name="name">account.payment.term.manual.form</field>
        <field name="model">account.payment.term.manual</field>
        <field name="inherit_id" ref="account.view_payment_term_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <field name="origin_term_id" invisible="1" />
            </xpath>

            <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                <attribute name="invisible">active or origin_term_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_payment_term_manual_form" model="ir.actions.act_window">
        <field name="name">Payment Terms</field>
        <field name="res_model">account.payment.term.manual</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_payment_term_manual_search" />
    </record>
</odoo>
