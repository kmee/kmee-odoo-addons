<odoo>

    <!-- O5: the boletos of the invoice in the portal sidebar, reached with the
         access token of the invoice. -->
    <template id="portal_invoice_page_brbank" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[hasclass('o_download_pdf')]/.." position="after">
            <t
                t-set="brbank_transactions"
                t-value="invoice._brbank_report_transactions()"
            />
            <li
                t-foreach="brbank_transactions"
                t-as="title"
                class="list-group-item flex-grow-1 o_brbank_title"
            >
                <div class="small mb-1">
                    <strong class="text-muted">Due</strong>
                    <span t-field="title.due_date" />
                    -
                    <span
                        t-field="title.amount"
                        t-options='{"widget": "monetary", "display_currency": title.currency_id}'
                    />
                </div>
                <div
                    t-if="title.digitable_line"
                    class="small text-break font-monospace"
                >
                    <span t-field="title.digitable_line" />
                </div>
                <div
                    t-if="title.pix_copia_cola"
                    class="small text-break font-monospace"
                >
                    <span t-field="title.pix_copia_cola" />
                </div>
                <a
                    t-if="title.boleto_pdf"
                    class="btn btn-secondary btn-sm mt-1"
                    t-att-href="'/my/invoices/%s/brbank/%s?access_token=%s&amp;download=true' % (invoice.id, title.id, invoice._portal_ensure_token())"
                >
                    <i class="fa fa-download" title="Download" /> Boleto
                </a>
            </li>
        </xpath>
    </template>

</odoo>
