<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_request_form" model="ir.ui.view">
        <field name="name">mrp.production.request.form.sale</field>
        <field name="model">mrp.production.request</field>
        <field
            name="inherit_id"
            ref="mrp_production_request.view_mrp_production_request_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="origin_sale_id" />
                <field name="partner_id" />
                <field name="sale_person_id" />
                <field name="notes_from_so" />
            </xpath>
        </field>
    </record>
    <record id="view_mrp_production_request_tree" model="ir.ui.view">
        <field name="name">mrp.production.request.list.sale</field>
        <field name="model">mrp.production.request</field>
        <field
            name="inherit_id"
            ref="mrp_production_request.view_mrp_production_request_tree"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="partner_id" optional="show" />
                <field name="sale_person_id" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_mrp_production_request_search" model="ir.ui.view">
        <field name="name">mrp.production.request.search.sale</field>
        <field name="model">mrp.production.request</field>
        <field
            name="inherit_id"
            ref="mrp_production_request.view_mrp_production_request_search"
        />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="origin_sale_id" />
                <field name="partner_id" />
            </field>
        </field>
    </record>
</odoo>
