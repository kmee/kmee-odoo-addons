<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="res_partner_marcenaria" model="res.partner">
        <field name="name">Marcenaria Bela Vista Ltda</field>
        <field name="is_company" eval="True" />
        <field name="street">Rua das Palmeiras, 410</field>
        <field name="city">Curitiba</field>
        <field name="zip">80030-100</field>
        <field name="email">compras@marcenariabelavista.example.com</field>
    </record>
    <record id="mrp_bom_mesa_jantar_reforcada" model="mrp.bom">
        <field
            name="product_tmpl_id"
            search="[('product_variant_ids', '=', ref('mrp_production_request.product_mesa_jantar'))]"
        />
        <field name="product_id" ref="mrp_production_request.product_mesa_jantar" />
        <field name="code">Reforçada</field>
        <field name="product_qty">1</field>
        <field name="type">normal</field>
        <field name="sequence">20</field>
    </record>
    <record id="mrp_bom_line_mesa_reforcada_tampo" model="mrp.bom.line">
        <field name="bom_id" ref="mrp_bom_mesa_jantar_reforcada" />
        <field name="product_id" ref="mrp_production_request.product_component_tampo" />
        <field name="product_qty">2</field>
    </record>
    <record id="mrp_bom_line_mesa_reforcada_pe" model="mrp.bom.line">
        <field name="bom_id" ref="mrp_bom_mesa_jantar_reforcada" />
        <field name="product_id" ref="mrp_production_request.product_component_pe" />
        <field name="product_qty">6</field>
    </record>
    <record id="sale_order_marcenaria" model="sale.order">
        <field name="name">PV-DEMO-0001</field>
        <field name="partner_id" ref="res_partner_marcenaria" />
        <field name="user_id" ref="base.user_demo" />
    </record>
    <record id="sale_order_line_marcenaria_mesa" model="sale.order.line">
        <field name="order_id" ref="sale_order_marcenaria" />
        <field name="product_id" ref="mrp_production_request.product_mesa_jantar" />
        <field name="product_uom_qty">4</field>
        <field name="explicit_bom_id" ref="mrp_bom_mesa_jantar_reforcada" />
        <field
            name="production_notes"
        >Acabamento em verniz fosco, conforme amostra aprovada pelo cliente.</field>
    </record>
    <record id="mrp_production_request_demo_sale" model="mrp.production.request">
        <field name="product_id" ref="mrp_production_request.product_mesa_jantar" />
        <field name="product_uom_id" ref="uom.product_uom_unit" />
        <field name="bom_id" ref="mrp_bom_mesa_jantar_reforcada" />
        <field name="product_qty">4</field>
        <field name="origin">PV-DEMO-0001</field>
        <field name="sale_line_id" ref="sale_order_line_marcenaria_mesa" />
    </record>
</odoo>
