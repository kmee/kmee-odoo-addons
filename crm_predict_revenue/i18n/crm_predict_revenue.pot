#. module: crm_predict_revenue
#: model:mail.template,body_html:crm_predict_revenue.mail_template_followup
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Olá <t t-out=\"object.contact_name or 'Prezado(a)'\"/>,\n"
"                        <br/><br/>\n"
"                        Estou fazendo um acompanhamento sobre nosso contato anterior.\n"
"                        <br/><br/>\n"
"                        Gostaria de saber se teve a oportunidade de analisar minha mensagem e se tem interesse em conversarmos sobre como podemos ajudar sua empresa.\n"
"                        <br/><br/>\n"
"                        Estou à disposição para esclarecer qualquer dúvida.\n"
"                        <br/><br/>\n"
"                        Atenciosamente,\n"
"                        <br/><br/>\n"
"                        <t t-if=\"object.user_id\">\n"
"                    <t t-out=\"object.user_id.name or ''\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.user_id.phone or ''\"/>\n"
"                </t>\n"
"                        <t t-else=\"\">\n"
"                            Equipe <t t-out=\"object.company_id.name or ''\"/>\n"
"                        </t>\n"
"                    </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: crm_predict_revenue
#: model:mail.template,body_html:crm_predict_revenue.mail_template_discovery_followup
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Olá <t t-out=\"object.contact_name or 'Prezado(a)'\"/>,\n"
"                        <br/><br/>\n"
"                        Muito obrigado pela nossa reunião de descoberta. Foi muito produtivo entender mais sobre suas necessidades e desafios.\n"
"                        <br/><br/>\n"
"                        Conforme prometido, estou enviando materiais adicionais que podem ser úteis:\n"
"                        <br/><br/>\n"
"                        1. Apresentação detalhada de nossa solução<br/>\n"
"                        2. Casos de sucesso de clientes similares<br/>\n"
"                        3. White paper sobre os benefícios e ROI<br/>\n"
"                        4. FAQ com perguntas comuns<br/>\n"
"                        <br/>\n"
"                        Gostaria de agendar uma apresentação personalizada para demonstrar como nossa solução pode atender especificamente aos desafios que você mencionou? Podemos programar para a próxima semana.\n"
"                        <br/><br/>\n"
"                        Aguardo seu retorno e continuo à disposição para qualquer esclarecimento.\n"
"                        <br/><br/>\n"
"                        Atenciosamente,\n"
"                        <br/><br/>\n"
"                        <t t-if=\"object.user_id\">\n"
"                    <t t-out=\"object.user_id.name or ''\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.user_id.phone or ''\"/>\n"
"                </t>\n"
"                        <t t-else=\"\">\n"
"                            Equipe <t t-out=\"object.company_id.name or ''\"/>\n"
"                        </t>\n"
"                    </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: crm_predict_revenue
#: model:mail.template,body_html:crm_predict_revenue.mail_template_initial_contact
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Olá <t t-out=\"object.contact_name or 'Prezado(a)'\"/>,\n"
"                        <br/><br/>\n"
"                        Obrigado por seu interesse na <t t-out=\"object.company_id.name or 'nossa empresa'\"/>.\n"
"                        <br/><br/>\n"
"                        Gostaria de entender melhor suas necessidades e como podemos ajudar sua empresa a alcançar seus objetivos.\n"
"                        <br/><br/>\n"
"                        Teria disponibilidade para uma breve conversa nos próximos dias? Posso ligar ou enviar um convite para uma reunião virtual, como preferir.\n"
"                        <br/><br/>\n"
"                        Aguardo seu retorno e estou à disposição.\n"
"                        <br/><br/>\n"
"                        Atenciosamente,\n"
"                        <br/><br/>\n"
"                        <t t-if=\"object.user_id\">\n"
"                    <t t-out=\"object.user_id.name or ''\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.user_id.phone or ''\"/>\n"
"                </t>\n"
"                        <t t-else=\"\">\n"
"                            Equipe <t t-out=\"object.company_id.name or ''\"/>\n"
"                        </t>\n"
"                    </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: crm_predict_revenue
#: model:mail.template,body_html:crm_predict_revenue.mail_template_notify_ae
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Olá <t t-out=\"object.user_id.name or 'Prezado(a)'\"/>,\n"
"                        <br/><br/>\n"
"                        Uma nova oportunidade qualificada foi designada para você:\n"
"                        <br/><br/>\n"
"                        <b>Nome:</b> <t t-out=\"object.name or ''\"/><br/>\n"
"                        <b>Empresa:</b> <t t-out=\"object.partner_name or ''\"/><br/>\n"
"                        <b>Contato:</b> <t t-out=\"object.contact_name or ''\"/><br/>\n"
"                        <b>Email:</b> <t t-out=\"object.email_from or ''\"/><br/>\n"
"                        <b>Telefone:</b> <t t-out=\"object.phone or ''\"/><br/>\n"
"                        <b>Receita Esperada:</b> <t t-out=\"object.expected_revenue or ''\"/><br/>\n"
"                        <br/>\n"
"                        <t t-if=\"'bant_budget_amount' in object._fields\">\n"
"                            <b>Qualificação BANT:</b><br/>\n"
"                            <b>Budget:</b> <t t-out=\"object.bant_budget_amount or 'Não definido'\"/><br/>\n"
"                            <b>Authority:</b> <t t-out=\"object.bant_authority_contact or 'Não definido'\"/> (<t t-out=\"object.bant_authority_role or ''\"/>)<br/>\n"
"                            <b>Need:</b> <t t-out=\"object.bant_need_description or 'Não definido'\"/><br/>\n"
"                            <b>Timeline:</b> <t t-out=\"object.bant_timeline_date or 'Não definido'\"/><br/>\n"
"                        </t>\n"
"                        <br/>\n"
"                        É recomendado entrar em contato em até 24 horas para agendar a próxima etapa.\n"
"                        <br/><br/>\n"
"                        Atenciosamente,\n"
"                        <br/>\n"
"                        Equipe de SDRs\n"
"                    </p>\n"
"            </div>\n"
"        "
msgstr ""

