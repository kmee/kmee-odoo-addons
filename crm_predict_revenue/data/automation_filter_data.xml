<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Filtro para leads novos -->
        <record id="filter_new_leads" model="automation.filter">
            <field name="name">Leads Novos</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field
            name="domain"
        >[('type', '=', 'lead'), ('stage_id', '=', ref('stage_lead_new'))]</field>
        </record>

