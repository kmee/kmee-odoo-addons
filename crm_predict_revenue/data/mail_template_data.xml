<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">


  <!-- Template de Email de Follow-up após Descoberta -->
        <record id="mail_template_discovery_followup" model="mail.template">
            <field name="name">Oportunidade - Material pós-Descoberta</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field
            name="subject"
        >Informações adicionais sobre {{ object.company_id.name }}</field>
            <field
            name="email_from"
        >{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Olá <t t-out="object.contact_name or 'Prezado(a)'" />,
                        <br /><br />
                        Muito obrigado pela nossa reunião de descoberta. Foi muito produtivo entender mais sobre suas necessidades e desafios.
                        <br /><br />
                        Conforme prometido, estou enviando materiais adicionais que podem ser úteis:
                        <br /><br />
                        1. Apresentação detalhada de nossa solução<br />
                        2. Casos de sucesso de clientes similares<br />
                        3. White paper sobre os benefícios e ROI<br />
                        4. FAQ com perguntas comuns<br />
                        <br />
                        Gostaria de agendar uma apresentação personalizada para demonstrar como nossa solução pode atender especificamente aos desafios que você mencionou? Podemos programar para a próxima semana.
                        <br /><br />
                        Aguardo seu retorno e continuo à disposição para qualquer esclarecimento.
                        <br /><br />
                        Atenciosamente,
                        <br /><br />
                        <t t-if="object.user_id">
                            <t t-out="object.user_id.name or ''" />
                            <br />
                            <t t-out="object.user_id.phone or ''" />
                        </t>
                        <t t-else="">
                            Equipe <t t-out="object.company_id.name or ''" />
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.lang_id.code or '' }}</field>
            <field name="auto_delete" eval="True" />
        </record>

        <!-- Template de Email Inicial -->
        <record id="mail_template_initial_contact" model="mail.template">
            <field name="name">Lead - Contato Inicial</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field
            name="subject"
        >{{ object.company_id.name }}: Vamos conversar sobre suas necessidades?</field>
            <field
            name="email_from"
        >{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Olá <t t-out="object.contact_name or 'Prezado(a)'" />,
                        <br /><br />
                        Obrigado por seu interesse na <t
                        t-out="object.company_id.name or 'nossa empresa'"
                    />.
                        <br /><br />
                        Gostaria de entender melhor suas necessidades e como podemos ajudar sua empresa a alcançar seus objetivos.
                        <br /><br />
                        Teria disponibilidade para uma breve conversa nos próximos dias? Posso ligar ou enviar um convite para uma reunião virtual, como preferir.
                        <br /><br />
                        Aguardo seu retorno e estou à disposição.
                        <br /><br />
                        Atenciosamente,
                        <br /><br />
                        <t t-if="object.user_id">
                            <t t-out="object.user_id.name or ''" />
                            <br />
                            <t t-out="object.user_id.phone or ''" />
                        </t>
                        <t t-else="">
                            Equipe <t t-out="object.company_id.name or ''" />
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.lang_id.code or '' }}</field>
            <field name="auto_delete" eval="True" />
        </record>

        <!-- Template de Email de Follow-up -->
        <record id="mail_template_followup" model="mail.template">
            <field name="name">Lead - Follow-up</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field name="subject">Acompanhamento: {{ object.name }}</field>
            <field
            name="email_from"
        >{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Olá <t t-out="object.contact_name or 'Prezado(a)'" />,
                        <br /><br />
                        Estou fazendo um acompanhamento sobre nosso contato anterior.
                        <br /><br />
                        Gostaria de saber se teve a oportunidade de analisar minha mensagem e se tem interesse em conversarmos sobre como podemos ajudar sua empresa.
                        <br /><br />
                        Estou à disposição para esclarecer qualquer dúvida.
                        <br /><br />
                        Atenciosamente,
                        <br /><br />
                        <t t-if="object.user_id">
                            <t t-out="object.user_id.name or ''" />
                            <br />
                            <t t-out="object.user_id.phone or ''" />
                        </t>
                        <t t-else="">
                            Equipe <t t-out="object.company_id.name or ''" />
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.lang_id.code or '' }}</field>
            <field name="auto_delete" eval="True" />
        </record>

        <!-- Template de Notificação para AEs -->
        <record id="mail_template_notify_ae" model="mail.template">
            <field name="name">Notificação de Nova Oportunidade para AE</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field
            name="subject"
        >Nova Oportunidade Qualificada: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted) }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Olá <t t-out="object.user_id.name or 'Prezado(a)'" />,
                        <br /><br />
                        Uma nova oportunidade qualificada foi designada para você:
                        <br /><br />
                        <b>Nome:</b> <t t-out="object.name or ''" /><br />
                        <b>Empresa:</b> <t t-out="object.partner_name or ''" /><br />
                        <b>Contato:</b> <t t-out="object.contact_name or ''" /><br />
                        <b>Email:</b> <t t-out="object.email_from or ''" /><br />
                        <b>Telefone:</b> <t t-out="object.phone or ''" /><br />
                        <b>Receita Esperada:</b> <t
                        t-out="object.expected_revenue or ''"
                    /><br />
                        <br />
                        <b>Qualificação BANT:</b><br />
                        <b>Budget:</b> <t
                        t-out="object.x_budget_value or 'Não definido'"
                    /><br />
                        <b>Authority:</b> <t
                        t-out="object.x_decision_maker or 'Não definido'"
                    /> (<t t-out="object.x_decision_maker_role or ''" />)<br />
                        <b>Need:</b> <t
                        t-out="object.x_need_description or 'Não definido'"
                    /><br />
                        <b>Timeline:</b> <t
                        t-out="object.x_purchase_date or 'Não definido'"
                    /><br />
                        <br />
                        É recomendado entrar em contato em até 24 horas para agendar a próxima etapa.
                        <br /><br />
                        Atenciosamente,
                        <br />
                        Equipe de SDRs
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.user_id.lang or '' }}</field>
            <field name="auto_delete" eval="True" />
        </record>

</odoo>
