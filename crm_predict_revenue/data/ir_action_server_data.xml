<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Ação para atualizar para fase de Apresentação -->
        <record id="action_update_to_presentation" model="ir.actions.server">
            <field name="name">Atualizar para Fase de Apresentação</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field name="binding_model_id" ref="crm.model_crm_lead" />
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.type == 'opportunity':
                        record.write({
                            'stage_id': env.ref('stage_opportunity_presentation').id
                        })
            </field>
        </record>

        <!-- Ação para atualizar para fase de Proposta -->
        <record id="action_update_to_proposal" model="ir.actions.server">
            <field name="name">Atualizar para Fase de Proposta</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field name="binding_model_id" ref="crm.model_crm_lead" />
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.type == 'opportunity':
                        record.write({
                            'stage_id': env.ref('stage_opportunity_proposal').id
                        })
            </field>
        </record>

        <!-- Ação para atualizar para fase de Negociação -->
        <record id="action_update_to_negotiation" model="ir.actions.server">
            <field name="name">Atualizar para Fase de Negociação</field>
            <field name="model_id" ref="crm.model_crm_lead" />
            <field name="binding_model_id" ref="crm.model_crm_lead" />
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    if record.type == 'opportunity':
                        record.write({
                            'stage_id': env.ref('stage_opportunity_negotiation').id
                        })
            </field>
        </record>
</odoo>
