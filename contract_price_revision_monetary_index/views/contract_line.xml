<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="model">contract.line</field>
        <field
            name="inherit_id"
            ref="contract_price_revision.contract_line_form_view"
        />
        <field name="arch" type="xml">
            <field name="never_revise_price" position="after">
                <field name="revision_index_id" invisible="not revision_index_id" />
                <field name="revision_period_start" invisible="not revision_index_id" />
                <field name="revision_period_end" invisible="not revision_index_id" />
                <field name="revision_factor" invisible="not revision_index_id" />
                <field name="revision_percent" invisible="not revision_index_id" />
            </field>
        </field>
    </record>
    <record id="contract_line_tree_view" model="ir.ui.view">
        <field name="model">contract.line</field>
        <field
            name="inherit_id"
            ref="contract_price_revision.contract_line_tree_view"
        />
        <field name="arch" type="xml">
            <field name="never_revise_price" position="after">
                <field name="revision_index_id" optional="hide" />
                <field name="revision_percent" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
