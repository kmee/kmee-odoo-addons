<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.document.import.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Importação OCR (Brasil)" id="document_import_ocr">
                    <setting
                        id="document_import_ocr_engine_setting"
                        string="Engine de OCR"
                        help="Usado quando o PDF não tem camada de texto (documento escaneado ou foto)."
                    >
                        <field name="document_import_ocr_engine" />
                    </setting>
                    <setting
                        id="document_import_destination_setting"
                        string="Destino da importação"
                        help="Criar somente o documento fiscal ou também a fatura de fornecedor."
                    >
                        <field name="document_import_destination" />
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="document_import_default_operation_id"
                                    string="Operação fiscal padrão"
                                    class="col-lg-4"
                                />
                                <field name="document_import_default_operation_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="document_import_default_product_id"
                                    string="Produto de serviço padrão"
                                    class="col-lg-4"
                                />
                                <field name="document_import_default_product_id" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
