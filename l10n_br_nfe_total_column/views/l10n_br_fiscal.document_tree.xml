<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="document_tree_inherit_nfe_total_column" model="ir.ui.view">
        <field name="name">document.tree.inherit.nfe.total.column</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="nfe40_vNF" string="Valor total da NF-e" />
            </xpath>

        </field>
    </record>
</odoo>
