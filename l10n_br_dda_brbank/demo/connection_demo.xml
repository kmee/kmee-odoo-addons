<odoo noupdate="1">
    <!-- Turns DDA on in the demo connection of the bank simulator (port 8899,
         python -m brbank.simulador, seed demo). The credentials are the
         defaults of the simulator, whose refresh token is valid from the start:
         no consent needed. Every value is fictitious. -->
    <record
        id="l10n_br_bank_connection.connection_demo_btg_simulator"
        model="l10n_br_bank_connection.connection"
    >
        <field name="client_id">sim-client</field>
        <field name="client_secret">sim-secret</field>
        <field name="refresh_token">sim-refresh-0</field>
        <field name="state">connected</field>
        <field name="dda_enabled" eval="True" />
    </record>
</odoo>
