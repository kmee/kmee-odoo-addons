<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_credit_analysis">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>Relatorio de Analise de Credito</h2>
                                <p class="text-muted">
                                    Consulta: <strong t-field="o.name" /> |
                                    Data: <span t-field="o.date" t-options='{"format": "dd/MM/yyyy HH:mm"}' />
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <t t-if="o.recommendation_final == 'approved'">
                                    <span class="badge bg-success fs-4">APROVADO</span>
                                </t>
                                <t t-if="o.recommendation_final == 'caution'">
                                    <span class="badge bg-warning fs-4">CAUTELA</span>
                                </t>
                                <t t-if="o.recommendation_final == 'rejected'">
                                    <span class="badge bg-danger fs-4">REJEITADO</span>
                                </t>
                            </div>
                        </div>

                        <!-- Subject Info - PJ (Pessoa Juridica) -->
                        <t t-if="o.subject_type == 'pj'">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">
                                            <strong>Dados da Empresa</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-6">
                                                    <p><strong>Razao Social:</strong> <span t-field="o.subject_id.name" /></p>
                                                    <p><strong>Nome Fantasia:</strong> <span t-field="o.subject_id.nome_fantasia" /></p>
                                                    <p><strong>CNPJ:</strong> <span t-field="o.subject_id.document_formatted" /></p>
                                                    <p><strong>Natureza Juridica:</strong> <span t-field="o.subject_id.natureza_juridica_id.name" /></p>
                                                </div>
                                                <div class="col-6">
                                                    <p><strong>Situacao Cadastral:</strong>
                                                        <t t-if="o.subject_id.situacao_cadastral == 'ativo'">
                                                            <span class="badge bg-success">Ativo</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'baixado'">
                                                            <span class="badge bg-danger">Baixado</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'suspenso'">
                                                            <span class="badge bg-warning">Suspenso</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'inapto'">
                                                            <span class="badge bg-danger">Inapto</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-field="o.subject_id.situacao_cadastral" />
                                                        </t>
                                                    </p>
                                                    <p><strong>Data de Fundacao:</strong> <span t-field="o.subject_id.data_fundacao" /></p>
                                                    <p><strong>Tempo de Atividade:</strong> <span t-field="o.subject_id.tempo_atividade" /> anos</p>
                                                    <p><strong>CNAE Principal:</strong> <span t-field="o.subject_id.cnae_principal_id" /></p>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-6">
                                                    <p><strong>Capital Social:</strong> <span t-field="o.subject_id.capital_social" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                </div>
                                                <div class="col-6">
                                                    <p><strong>Capital Atual:</strong> <span t-field="o.subject_id.capital_atual" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <p><strong>Endereco:</strong> <span t-field="o.subject_id.full_address" /></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Subject Info - PF (Pessoa Fisica) -->
                        <t t-if="o.subject_type == 'pf'">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-primary text-white">
                                            <strong>Dados Pessoais</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-6">
                                                    <p><strong>Nome:</strong> <span t-field="o.subject_id.name" /></p>
                                                    <p><strong>CPF:</strong> <span t-field="o.subject_id.document_formatted" /></p>
                                                    <p><strong>Data de Nascimento:</strong> <span t-field="o.subject_id.data_nascimento" /></p>
                                                    <p><strong>Idade:</strong> <span t-field="o.subject_id.idade" /> anos</p>
                                                </div>
                                                <div class="col-6">
                                                    <p><strong>Situacao Cadastral:</strong>
                                                        <t t-if="o.subject_id.situacao_cadastral == 'regular'">
                                                            <span class="badge bg-success">Regular</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'pendente'">
                                                            <span class="badge bg-warning">Pendente</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'cancelado'">
                                                            <span class="badge bg-danger">Cancelado</span>
                                                        </t>
                                                        <t t-elif="o.subject_id.situacao_cadastral == 'nulo'">
                                                            <span class="badge bg-danger">Nulo</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-field="o.subject_id.situacao_cadastral" />
                                                        </t>
                                                    </p>
                                                    <p><strong>Nome da Mae:</strong> <span t-field="o.subject_id.nome_mae" /></p>
                                                    <p><strong>Estado Civil:</strong> <span t-field="o.subject_id.estado_civil" /></p>
                                                    <p><strong>Sexo:</strong> <span t-field="o.subject_id.sexo" /></p>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <p><strong>Endereco:</strong> <span t-field="o.subject_id.full_address" /></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- PF - Informacoes Profissionais e Renda -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-info text-white">
                                            <strong>Informacoes Profissionais e Renda</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-6">
                                                    <p><strong>Profissao:</strong> <span t-field="o.subject_id.profissao" /></p>
                                                    <p><strong>Empregador:</strong> <span t-field="o.subject_id.empregador" /></p>
                                                    <p><strong>Data de Admissao:</strong> <span t-field="o.subject_id.data_admissao" /></p>
                                                </div>
                                                <div class="col-6">
                                                    <p><strong>Renda Mensal Declarada:</strong> <span t-field="o.subject_id.renda_mensal" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                    <p><strong>Faixa de Renda:</strong> <span t-field="o.renda_faixa" /></p>
                                                    <p><strong>Renda Comprovada:</strong> <span t-field="o.renda_comprovada" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Score and Risk Analysis -->
                        <div class="row mb-4">
                            <div class="col-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Score</h5>
                                        <h2 t-field="o.score" />
                                        <p>
                                            <t t-if="o.risk_level == 'very_high'">
                                                <span class="badge bg-danger">Muito Alto</span>
                                            </t>
                                            <t t-if="o.risk_level == 'high'">
                                                <span class="badge bg-danger">Alto</span>
                                            </t>
                                            <t t-if="o.risk_level == 'medium'">
                                                <span class="badge bg-warning">Medio</span>
                                            </t>
                                            <t t-if="o.risk_level == 'low'">
                                                <span class="badge bg-success">Baixo</span>
                                            </t>
                                            <t t-if="o.risk_level == 'very_low'">
                                                <span class="badge bg-success">Muito Baixo</span>
                                            </t>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Prob. Inadimplencia</h5>
                                        <h2><span t-field="o.default_probability" />%</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Restricoes</h5>
                                        <h2 t-field="o.total_restricoes_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                        <p>
                                            <t t-if="o.has_restricoes">
                                                <span class="badge bg-danger">Com Restricoes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-success">Sem Restricoes</span>
                                            </t>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Limite Sugerido</h5>
                                        <h2 t-field="o.limite_credito_final" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Restrictions Summary -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header bg-danger text-white">
                                        <strong>Resumo de Restricoes</strong>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-3">
                                                <p><strong>Negativacoes:</strong></p>
                                                <p>Quantidade: <span t-field="o.total_negativacoes" /></p>
                                                <p>Valor: <span t-field="o.total_negativacoes_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                            </div>
                                            <div class="col-3">
                                                <p><strong>Protestos:</strong></p>
                                                <p>Quantidade: <span t-field="o.total_protestos" /></p>
                                                <p>Valor: <span t-field="o.total_protestos_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                            </div>
                                            <div class="col-3">
                                                <p><strong>Acoes Judiciais:</strong></p>
                                                <p>Quantidade: <span t-field="o.total_acoes" /></p>
                                                <p>Valor: <span t-field="o.total_acoes_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                            </div>
                                            <div class="col-3">
                                                <p><strong>Cheques:</strong></p>
                                                <p>Quantidade: <span t-field="o.total_cheques" /></p>
                                                <p>
                                                    <t t-if="o.has_falencia">
                                                        <span class="badge bg-danger">Falencia/Recuperacao Judicial</span>
                                                    </t>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Restrictions Detail -->
                        <t t-if="o.restriction_ids">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <strong>Detalhamento de Restricoes</strong>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-sm table-striped mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Tipo</th>
                                                        <th>Data</th>
                                                        <th>Valor</th>
                                                        <th>Credor</th>
                                                        <th>Situacao</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="o.restriction_ids" t-as="r">
                                                        <tr>
                                                            <td t-field="r.type" />
                                                            <td t-field="r.date" />
                                                            <td t-field="r.value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                            <td t-field="r.creditor" />
                                                            <td>
                                                                <t t-if="r.state == 'active'">
                                                                    <span class="badge bg-danger">Ativa</span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-success">Resolvida</span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Payment Behavior -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header bg-info text-white">
                                        <strong>Comportamento de Pagamento</strong>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-4">
                                                <p><strong>Score de Pontualidade:</strong> <span t-field="o.pontualidade_score" /></p>
                                                <p>
                                                    <t t-if="o.pontualidade_nivel == 'alto'">
                                                        <span class="badge bg-success">Alto</span>
                                                    </t>
                                                    <t t-if="o.pontualidade_nivel == 'medio'">
                                                        <span class="badge bg-warning">Medio</span>
                                                    </t>
                                                    <t t-if="o.pontualidade_nivel == 'baixo'">
                                                        <span class="badge bg-danger">Baixo</span>
                                                    </t>
                                                </p>
                                            </div>
                                            <div class="col-4">
                                                <p><strong>Score de Atraso:</strong> <span t-field="o.atraso_score" /></p>
                                                <p>
                                                    <t t-if="o.atraso_nivel == 'baixo'">
                                                        <span class="badge bg-success">Baixo</span>
                                                    </t>
                                                    <t t-if="o.atraso_nivel == 'medio'">
                                                        <span class="badge bg-warning">Medio</span>
                                                    </t>
                                                    <t t-if="o.atraso_nivel == 'alto'">
                                                        <span class="badge bg-danger">Alto</span>
                                                    </t>
                                                </p>
                                            </div>
                                            <div class="col-4">
                                                <p><strong>Media de Dias em Atraso:</strong> <span t-field="o.media_dias_atraso" /> dias</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Credit History -->
                        <t t-if="o.credit_history_ids">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <strong>Historico de Credito (Ultimos 12 meses)</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-2">
                                                <div class="col-6">
                                                    <strong>Total:</strong> <span t-field="o.total_credito_12m" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                </div>
                                                <div class="col-6">
                                                    <strong>Media:</strong> <span t-field="o.media_credito_12m" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                </div>
                                            </div>
                                            <table class="table table-sm table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Mes/Ano</th>
                                                        <th>Valor</th>
                                                        <th>Variacao</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="o.credit_history_ids" t-as="h">
                                                        <tr>
                                                            <td><span t-field="h.month" />/<span t-field="h.year" /></td>
                                                            <td t-field="h.value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                            <td><span t-field="h.variation" />%</td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Partners (Shareholders) - Only for PJ -->
                        <t t-if="o.subject_type == 'pj' and o.subject_id.partner_ids">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-secondary text-white">
                                            <strong>Quadro Societario</strong>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-sm table-striped mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Nome</th>
                                                        <th>Documento</th>
                                                        <th>Participacao</th>
                                                        <th>Situacao</th>
                                                        <th>Debitos</th>
                                                        <th>Restricoes</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="o.subject_id.partner_ids" t-as="p">
                                                        <tr>
                                                            <td t-field="p.name" />
                                                            <td t-field="p.document_formatted" />
                                                            <td><span t-field="p.participation" />%</td>
                                                            <td>
                                                                <t t-if="p.situation == 'regular'">
                                                                    <span class="badge bg-success">Regular</span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-danger">Irregular</span>
                                                                </t>
                                                            </td>
                                                            <td>
                                                                <t t-if="p.has_debts">
                                                                    <span class="badge bg-danger">Sim</span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-success">Nao</span>
                                                                </t>
                                                            </td>
                                                            <td t-field="p.total_restrictions" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- PJ - Faturamento -->
                        <t t-if="o.subject_type == 'pj'">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <strong>Informacoes de Faturamento</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-4">
                                                    <p><strong>Faturamento Declarado:</strong> <span t-field="o.faturamento_declarado" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                </div>
                                                <div class="col-4">
                                                    <p><strong>Faturamento Presumido:</strong> <span t-field="o.faturamento_presumido" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></p>
                                                </div>
                                                <div class="col-4">
                                                    <p><strong>Porte da Empresa:</strong> <span t-field="o.faturamento_porte" /></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Commitments -->
                        <t t-if="o.commitment_ids">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <strong>Compromissos Financeiros</strong>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-2">
                                                <div class="col-4">
                                                    <strong>Total a Vencer:</strong> <span t-field="o.total_compromissos_vencer" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                </div>
                                                <div class="col-4">
                                                    <strong>Total Vencido:</strong> <span t-field="o.total_compromissos_vencidos" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                </div>
                                                <div class="col-4">
                                                    <strong>Qtd. Credores:</strong> <span t-field="o.qtd_credores" />
                                                </div>
                                            </div>
                                            <table class="table table-sm table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Tipo</th>
                                                        <th>Instituicao</th>
                                                        <th>Valor</th>
                                                        <th>Vencimento</th>
                                                        <th>Situacao</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="o.commitment_ids" t-as="c">
                                                        <tr>
                                                            <td t-field="c.type" />
                                                            <td t-field="c.institution" />
                                                            <td t-field="c.value" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                                            <td t-field="c.due_date" />
                                                            <td>
                                                                <t t-if="c.state == 'pending'">
                                                                    <span class="badge bg-info">A Vencer</span>
                                                                </t>
                                                                <t t-elif="c.state == 'overdue'">
                                                                    <span class="badge bg-danger">Vencido</span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge bg-success">Pago</span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Override Notes -->
                        <t t-if="o.recommendation_override and o.recommendation_notes">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header bg-warning">
                                            <strong>Justificativa do Override de Recomendacao</strong>
                                        </div>
                                        <div class="card-body">
                                            <p t-field="o.recommendation_notes" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Notes -->
                        <t t-if="o.notes">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <strong>Observacoes</strong>
                                        </div>
                                        <div class="card-body">
                                            <span t-field="o.notes" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Footer / Disclaimer -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <hr />
                                <p class="text-muted small">
