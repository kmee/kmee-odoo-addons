<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Menu -->
    <menuitem id="menu_credit_root"
        name="Credito"
        sequence="45"
        web_icon="credit_analysis,static/description/icon.png"
        groups="credit_analysis.group_credit_user" />

    <!-- Consultas Menu -->
    <menuitem id="menu_credit_analysis"
        name="Consultas"
        parent="menu_credit_root"
        sequence="10" />

    <menuitem id="menu_credit_analysis_list"
        name="Consultas de Credito"
        parent="menu_credit_analysis"
        action="credit_analysis_action"
        sequence="10" />

    <!-- Cadastros Menu -->
    <menuitem id="menu_credit_master"
        name="Cadastros"
        parent="menu_credit_root"
        sequence="20" />

    <menuitem id="menu_credit_subject_list"
        name="Todos os Cadastros"
        parent="menu_credit_master"
        action="credit_subject_action"
        sequence="5" />

    <menuitem id="menu_credit_subject_pf"
        name="Pessoas Fisicas (CPF)"
        parent="menu_credit_master"
        action="credit_subject_pf_action"
        sequence="10" />

    <menuitem id="menu_credit_subject_pj"
        name="Pessoas Juridicas (CNPJ)"
        parent="menu_credit_master"
        action="credit_subject_pj_action"
        sequence="20" />

    <menuitem id="menu_credit_partner_list"
        name="Socios"
        parent="menu_credit_master"
        action="credit_partner_action"
        sequence="30" />

    <menuitem id="menu_credit_restriction_list"
        name="Restricoes"
        parent="menu_credit_master"
        action="credit_restriction_action"
        sequence="40" />

    <!-- Configuration Menu -->
    <menuitem id="menu_credit_config"
        name="Configuracao"
        parent="menu_credit_root"
        sequence="90"
        groups="credit_analysis.group_credit_manager" />

    <menuitem id="menu_credit_config_params"
        name="Parametros"
        parent="menu_credit_config"
        action="credit_config_action"
        sequence="10" />

    <menuitem id="menu_credit_cnae"
        name="CNAE"
        parent="menu_credit_config"
        action="credit_cnae_action"
        sequence="20" />

    <menuitem id="menu_credit_natureza_juridica"
        name="Natureza Juridica"
        parent="menu_credit_config"
        action="credit_natureza_juridica_action"
        sequence="30" />

</odoo>
