<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_form_fill_nfe" model="ir.ui.view">
        <field name="name">stock.picking.form (in l10n_br_stock_lot_nfe)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="before">
                <button
                    name="action_fill_from_nfe"
                    type="object"
                    string="Preencher por NF-e"
                    invisible="picking_type_code != 'incoming' or state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_lot_nfe" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.lot.nfe</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute
                    name="context"
                >{'active_picking_id': picking_id, 'default_product_id': parent.product_id, 'default_origin_picking_id': picking_id, 'default_origin_stock_move_line_id': id}</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record
        id="view_stock_move_line_detailed_operation_tree_lot_nfe"
        model="ir.ui.view"
    >
        <field name="name">stock.move.line.detailed.operations.list.lot.nfe</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute
                    name="context"
                >{'default_product_id': product_id, 'active_picking_id': picking_id, 'default_origin_picking_id': picking_id, 'default_origin_stock_move_line_id': id}</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
