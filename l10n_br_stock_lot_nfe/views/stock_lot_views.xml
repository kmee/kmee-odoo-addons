<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_lot_view_form" model="ir.ui.view">
        <field name="name">stock.lot.form (in l10n_br_stock_lot_nfe)</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="before">
                <field name="simple_name" readonly="1" class="oe_read_only" />
                <field name="origin" readonly="1" />
                <field name="origin_picking_id" readonly="1" />
                <field name="origin_purchase_id" readonly="1" />
                <field name="origin_sale_id" readonly="1" />
                <field name="numero_nota" />
                <field
                    name="origin_nfe_id"
                    options="{'no_create': True}"
                    context="{'show_name_for_lot_creation': True}"
                />
                <field
                    name="origin_nfe_line_id"
                    domain="[('document_id', '=', origin_nfe_id), ('product_id', '=', product_id)]"
                    options="{'no_create': True}"
                    context="{'show_name_for_lot_creation': True}"
                    invisible="not origin_nfe_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
