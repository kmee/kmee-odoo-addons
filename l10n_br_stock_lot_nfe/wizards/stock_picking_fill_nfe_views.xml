<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_fill_nfe_form" model="ir.ui.view">
        <field name="name">stock.picking.fill.nfe.form</field>
        <field name="model">stock.picking.fill.nfe</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="picking_id" invisible="1" />
                    <field
                        name="document_id"
                        options="{'no_create': True}"
                        context="{'show_name_for_lot_creation': True}"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Preencher"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
