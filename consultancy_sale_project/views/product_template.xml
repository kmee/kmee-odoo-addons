<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record model="ir.ui.view" id="product_template_employee">
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_contract.product_template_form_contract_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="employees" string="Employees" groups="hr.group_hr_user">
                    <field name="employee_line_ids" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
