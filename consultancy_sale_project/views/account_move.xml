<odoo>

    <record model="ir.ui.view" id="account_move_form_view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="custom_settings" string="Settings">
                    <field name="contract_config_line_ids">
                        <tree>
                            <field name="product_id" readonly="1" />
                            <field name="name" readonly="1" />
                            <field name="timesheet_invoice_workflow" />
                            <field name="timesheet_report_type" />
                            <field name="timesheet_report_detais" />
                            <field name="timesheet_report_id" />
                            <field name="timesheet_email_aproval_template" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


