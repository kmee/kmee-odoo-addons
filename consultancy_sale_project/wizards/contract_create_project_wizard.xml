<odoo>

    <record model="ir.ui.view" id="contract_create_project_wizard_form_view">
        <field name="model">contract.create.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Contract Create Project Wizard">
                <field name="contract_id" />
                <group>
                    <group>
                        <field name="name" />
                        <field name="project_template_id" />
                        <field name="default_contract_line_id" />
                        <field name="analytic_account_id" />
                    </group>
                    <group>
                        <field name="allow_billable" />
                        <field name="allow_timesheets" />
                        <field name="allow_milestones" />
                    </group>
                </group>
                <footer>
                    <button name="doit" string="OK" class="btn-primary" type="object" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="contract_create_project_wizard_act_window"
    >
        <field name="name">Contract Create Project Wizard</field> <!-- TODO -->
        <field name="res_model">contract.create.project.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


</odoo>
