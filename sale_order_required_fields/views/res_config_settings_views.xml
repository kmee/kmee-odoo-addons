<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.required.fields</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='quotation_order_setting_container']"
                position="inside"
            >
                <setting
                    id="sale_require_payment_mode"
                    help="Orders cannot be confirmed without a payment mode"
                >
                    <field name="sale_require_payment_mode" />
                </setting>
                <setting
                    id="sale_require_payment_term"
                    help="Orders cannot be confirmed without payment terms"
                >
                    <field name="sale_require_payment_term" />
                </setting>
                <setting
                    id="sale_require_line_date"
                    help="Every order line must have a delivery date"
                >
                    <field name="sale_require_line_date" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
