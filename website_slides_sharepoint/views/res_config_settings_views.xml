<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form.inherit.website.slides.sharepoint</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_slides.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//div[@id='website_slides_selection_settings']"
                position="after"
            >
                <h2>Microsoft 365 / SharePoint</h2>
                <div
                    class="row mt16 o_settings_container"
                    id="website_slides_sharepoint_settings"
                >
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">SharePoint Content</span>
                            <div class="text-muted">
                                Serve videos and documents stored on SharePoint / OneDrive
                                to your attendees, including anonymous ones. Register an
                                application in Azure AD with the
                                <em>Files.Read.All</em> and <em>Sites.Read.All</em>
                                application permissions, granted with admin consent.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="sharepoint_tenant_id"
                                        class="col-lg-3 o_light_label"
                                        string="Tenant ID"
                                    />
                                    <field
                                        name="sharepoint_tenant_id"
                                        class="oe_inline"
                                    />
                                </div>
                                <div class="row">
                                    <label
                                        for="sharepoint_client_id"
                                        class="col-lg-3 o_light_label"
                                        string="Client ID"
                                    />
                                    <field
                                        name="sharepoint_client_id"
                                        class="oe_inline"
                                    />
                                </div>
                                <div class="row">
                                    <label
                                        for="sharepoint_client_secret"
                                        class="col-lg-3 o_light_label"
                                        string="Client Secret"
                                    />
                                    <field
                                        name="sharepoint_client_secret"
                                        password="True"
                                        class="oe_inline"
                                    />
                                </div>
                                <div class="row">
                                    <label
                                        for="sharepoint_delivery_mode"
                                        class="col-lg-3 o_light_label"
                                        string="Delivery"
                                    />
                                    <field
                                        name="sharepoint_delivery_mode"
                                        class="oe_inline"
                                    />
                                </div>
                                <div class="oe_link">
                                    <a
                                        href="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade"
                                        target="_blank"
                                    ><span class="fa fa-arrow-right" />
                                        Register an application in Azure AD
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
