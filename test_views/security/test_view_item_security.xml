<odoo>
    <!-- Permite que todos os usuários internos possam ver e editar -->
    <record id="test_view_item_rule_users" model="ir.rule">
        <field name="name">Test View Item: users access</field>
        <field name="model_id" ref="model_test_view_item" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Permite CRUD: read, write, create, unlink -->
    <record id="test_view_item_access_user" model="ir.model.access">
        <field name="name">test.view.item user access</field>
        <field name="model_id" ref="model_test_view_item" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
