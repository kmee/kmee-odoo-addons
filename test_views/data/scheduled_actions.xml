<odoo>
    <!-- Scheduled action to test the purchase order form view -->
    <record id="cron_test_purchase_view" model="ir.cron">
        <field name="name">Test Purchase Order Form View</field>
        <field name="model_id" ref="base.model_ir_cron" />
        <field name="state">code</field>

        <!-- This executes your test -->
        <field name="code">
env['test.view.runner'].run_view_test()
        </field>

        <!-- Run every 60 minutes (you can change it) -->
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>

        <!-- Disable by default so it doesn’t run automatically -->
        <field name="active">False</field>
    </record>
</odoo>
