<odoo>
    <record
        id="product_pricelist_item_form_view_inherit_supplierinfo_currency"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.pricelist.item.form.inherit.supplierinfo.currency</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='base']" position="after">
                <field
                    name="filter_by_pricelist_currency"
                    attrs="{'invisible': [('base', '!=', 'supplierinfo')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
