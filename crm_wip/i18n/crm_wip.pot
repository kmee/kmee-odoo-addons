#. module: crm_wip
#: model:ir.module.module,description:base.module_crm_wip
msgid ""
"=======\n"
"CRM WIP\n"
"=======\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
