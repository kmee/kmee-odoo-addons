<odoo>
    <record id="action_reprocess_descriptions" model="ir.actions.server">
        <field name="name">Reprocess helpdesk descriptions</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="state">code</field>
        <field
            name="code"
        >env["helpdesk.ticket"].action_reprocess_descriptions()</field>
    </record>

    <record id="cron_reprocess_descriptions" model="ir.cron">
        <field name="name">Reprocess helpdesk descriptions (one-off)</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="state">code</field>
        <field name="code">model.action_reprocess_descriptions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">1</field>
        <field name="active" eval="False" />
    </record>
</odoo>
