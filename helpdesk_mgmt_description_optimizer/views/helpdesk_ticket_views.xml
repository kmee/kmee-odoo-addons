<odoo>
    <record id="ticket_view_form_description_optimizer" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.description.optimizer</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <field name="description" position="attributes">
                <attribute name="widget">description_optimizer</attribute>
            </field>
            <field name="description" position="after">
                <field name="description_summary" invisible="1" />
                <field name="has_description_full" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
