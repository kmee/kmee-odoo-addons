<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_monetary_index_tree" model="ir.ui.view">
        <field name="name">monetary.index.list</field>
        <field name="model">monetary.index</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="authority" />
                <field name="country_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_monetary_index_form" model="ir.ui.view">
        <field name="name">monetary.index.form</field>
        <field name="model">monetary.index</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="authority" />
                        </group>
                        <group>
                            <field name="country_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            placeholder="Enter a detailed description of the index..."
                        />
                    </group>
                    <notebook>
                        <page string="Rates" name="rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="date" />
                                    <field name="value" />
                                    <field name="source" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_monetary_index_search" model="ir.ui.view">
        <field name="name">monetary.index.search</field>
        <field name="model">monetary.index</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Name or Code"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                />
                <field name="code" />
                <field name="authority" />
                <field name="country_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <separator />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="filter_inactive"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <group>
                    <filter
                        string="Country"
                        name="group_by_country"
                        context="{'group_by': 'country_id'}"
                    />
                    <filter
                        string="Authority"
                        name="group_by_authority"
                        context="{'group_by': 'authority'}"
                    />
                    <filter
                        string="Company"
                        name="group_by_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_monetary_index" model="ir.actions.act_window">
        <field name="name">Monetary Indexes</field>
        <field name="res_model">monetary.index</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_monetary_index_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Monetary Index
            </p>
            <p>
                Monetary indexes are used to track and apply monetary corrections based on official indexes like SELIC, IPCA, INPC, etc.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_monetary_update_root"
        name="Monetary Indexes"
        parent="base.menu_administration"
        action="action_monetary_index"
        groups="group_monetary_update_manager"
        sequence="100"
    />
</odoo>
