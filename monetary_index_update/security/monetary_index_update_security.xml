<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">

        <!-- Categories -->
        <record id="module_category_monetary_update" model="ir.module.category">
            <field name="name">Monetary Index Update</field>
            <field name="description">Manage monetary update indexes and rates</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_monetary_update_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_monetary_update" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="comment">User can view and use monetary update indexes</field>
        </record>

        <record id="group_monetary_update_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_monetary_update" />
            <field name="implied_ids" eval="[(4, ref('group_monetary_update_user'))]" />
            <field
                name="comment"
            >Manager can create, edit and delete monetary indexes and rates</field>
        </record>

    </data>

    <!-- Record Rules -->
    <data noupdate="1">

        <!-- Multi-company rule for monetary.index -->
        <record id="monetary_index_company_rule" model="ir.rule">
            <field name="name">Monetary Index Update: multi-company</field>
            <field name="model_id" ref="model_monetary_index" />
            <field name="domain_force">[
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True" />
        </record>

        <!-- Multi-company rule for monetary.index.rate -->
        <record id="monetary_index_rate_company_rule" model="ir.rule">
            <field name="name">Monetary Index Update Rate: multi-company</field>
            <field name="model_id" ref="model_monetary_index_rate" />
            <field name="domain_force">[
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True" />
        </record>

    </data>
</odoo>
