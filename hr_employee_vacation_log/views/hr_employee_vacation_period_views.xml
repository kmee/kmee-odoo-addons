<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_vacation_period_view_list" model="ir.ui.view">
        <field name="name">hr.employee.vacation.period.list</field>
        <field name="model">hr.employee.vacation.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" />
                <field name="department_id" optional="show" />
                <field name="date_from" />
                <field name="date_to" required="1" />
                <field name="deadline" />
                <field name="entitled_days" />
                <field name="taken_days" />
                <field name="remaining_days" />
            </list>
        </field>
    </record>
    <record id="hr_employee_vacation_period_view_form" model="ir.ui.view">
        <field name="name">hr.employee.vacation.period.form</field>
        <field name="model">hr.employee.vacation.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="date_from" />
                            <field name="date_to" required="1" />
                            <field name="deadline" />
                        </group>
                        <group>
                            <field name="entitled_days" />
                            <field name="taken_days" />
                            <field name="remaining_days" />
                        </group>
                    </group>
                    <field
                        name="vacation_ids"
                        context="{'default_employee_id': employee_id, 'default_period_id': id}"
                    >
                        <list editable="bottom">
                            <field name="employee_id" column_invisible="1" />
                            <field name="date_from" />
                            <field name="date_to" required="1" />
                            <field name="days" />
                            <field name="cash_bonus" />
                            <field name="thirteenth_advance" />
                            <field name="note" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_employee_vacation_period_view_search" model="ir.ui.view">
        <field name="name">hr.employee.vacation.period.search</field>
        <field name="model">hr.employee.vacation.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="department_id" />
                <filter
                    name="with_balance"
                    string="With Remaining Days"
                    domain="[('remaining_days', '>', 0)]"
                />
                <filter
                    name="expiring"
                    string="Expiring Soon"
                    domain="[('remaining_days', '>', 0), ('deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('deadline', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"
                    help="Periods with days left whose limit to start the vacation falls in the next 90 days."
                />
                <filter
                    name="overdue"
                    string="Overdue"
                    domain="[('remaining_days', '>', 0), ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Periods with days left whose limit to start the vacation has passed."
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_department"
                        string="Department"
                        context="{'group_by': 'department_id'}"
                    />
                    <filter
                        name="group_employee"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="hr_employee_vacation_period_action" model="ir.actions.act_window">
        <field name="name">Vacation Periods</field>
        <field name="res_model">hr.employee.vacation.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_with_balance': 1}</field>
    </record>
    <menuitem
        id="hr_employee_vacation_period_menu"
        name="Vacation Periods"
        parent="hr.menu_hr_employee_payroll"
        action="hr_employee_vacation_period_action"
        sequence="20"
    />
</odoo>
